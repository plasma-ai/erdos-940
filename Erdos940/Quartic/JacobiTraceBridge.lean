import Erdos940.Quartic.JacobiGaussianGenerator
import Erdos940.Quartic.GaussianHeckeCharacters

/-!
# The Jacobi evaluation in the quartic local trace

For a normalized Gaussian prime above a split rational prime, the quartic
character chosen by reduction has Jacobi square `π²`. The resulting local
Gauss terms are the five constituents in the quartic Euler expansion.
-/

namespace Erdos940.Quartic

open scoped BigOperators
open NumberField IsDedekindDomain
open AlgebraicNumberTheory.PowerResidueSymbols

attribute [local instance] Ideal.Quotient.field

/-- Transport a Gaussian-prime reduction to the cyclotomic integer ring. -/
noncomputable def fourthIntegerRingReduction
    (q : ℕ) (ρ : GaussianInt →+* ZMod q) :
    𝓞 GaussianField →+* ZMod q :=
  ρ.comp gaussianFourthIntegerRingEquiv.symm.toRingHom

@[simp] theorem fourthIntegerRingReduction_gaussian
    (q : ℕ) (ρ : GaussianInt →+* ZMod q) (z : GaussianInt) :
    fourthIntegerRingReduction q ρ (gaussianFourthIntegerRingEquiv z) = ρ z := by
  simp [fourthIntegerRingReduction]

/-- The kernel of a reduction to `ZMod q` is a nonzero prime ideal as
soon as it contains a nonzero Gaussian prime. -/
noncomputable def gaussianPrimeIdealOfReduction
    (q : ℕ) [Fact q.Prime] (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt) (hπ0 : π ≠ 0) (hρπ : ρ π = 0) :
    HeightOneSpectrum (𝓞 GaussianField) where
  asIdeal := RingHom.ker (fourthIntegerRingReduction q ρ)
  isPrime := RingHom.ker_isPrime _
  ne_bot := by
    intro hbot
    have hmem : gaussianFourthIntegerRingEquiv π ∈
        RingHom.ker (fourthIntegerRingReduction q ρ) := by
      simp [RingHom.mem_ker, hρπ]
    rw [hbot, Ideal.mem_bot] at hmem
    exact hπ0 (gaussianFourthIntegerRingEquiv.injective (by simpa using hmem))

theorem gaussianPrimeIdealOfReduction_absNorm
    (q : ℕ) [Fact q.Prime] (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt) (hπ0 : π ≠ 0) (hρπ : ρ π = 0) :
    Ideal.absNorm (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal = q := by
  let f := fourthIntegerRingReduction q ρ
  have hf : Function.Surjective f := ZMod.ringHom_surjective f
  have he : (𝓞 GaussianField ⧸ (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal)
      ≃+* ZMod q := by
    exact RingHom.quotientKerEquivOfSurjective hf
  rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
  exact (Nat.card_congr he.toEquiv).trans (by simp [Nat.card_eq_fintype_card, ZMod.card])

theorem gaussianPrimeIdealOfReduction_coprime_four
    (q : ℕ) [Fact q.Prime] (hqmod : q % 4 = 1)
    (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt) (hπ0 : π ≠ 0) (hρπ : ρ π = 0) :
    (Ideal.absNorm
      (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal).Coprime 4 := by
  rw [gaussianPrimeIdealOfReduction_absNorm]
  apply Nat.coprime_of_mul_modEq_one 1
  change q * 1 % 4 = 1 % 4
  omega

theorem gaussianPrimeIdealOfReduction_not_mem
    (q : ℕ) [Fact q.Prime] (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt) (hπ0 : π ≠ 0) (hρπ : ρ π = 0)
    (z : GaussianInt) (hz : ρ z ≠ 0) :
    gaussianFourthIntegerRingEquiv z ∉
      (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal := by
  intro hmem
  have hz0 : ρ z = 0 := by
    change gaussianFourthIntegerRingEquiv z ∈
      RingHom.ker (fourthIntegerRingReduction q ρ) at hmem
    simpa [RingHom.mem_ker] using hmem
  exact hz hz0

theorem gaussianPrime_ne_zero_of_norm
    (q : ℕ) [Fact q.Prime] (π : GaussianInt)
    (hπnorm : π.norm = q) : π ≠ 0 := by
  intro hzero
  have hq0 : q = 0 := by
    have h := hπnorm
    simp [hzero] at h
    omega
  exact (Fact.out : q.Prime).ne_zero hq0

/-- The kernel prime is the principal ideal generated by the transported
Gaussian prime. -/
theorem gaussianPrimeIdealOfReduction_eq_span
    (q : ℕ) [Fact q.Prime] (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt) (hπ0 : π ≠ 0) (hρπ : ρ π = 0)
    (hρkernel : ∀ z : GaussianInt, ρ z = 0 ↔ π ∣ z) :
    (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal =
      Ideal.span {gaussianFourthIntegerRingEquiv π} := by
  apply Ideal.ext
  intro z
  change ρ (gaussianFourthIntegerRingEquiv.symm z) = 0 ↔
    z ∈ Ideal.span {gaussianFourthIntegerRingEquiv π}
  rw [hρkernel, Ideal.mem_span_singleton]
  simpa using (map_dvd_iff gaussianFourthIntegerRingEquiv
    (a := π) (b := gaussianFourthIntegerRingEquiv.symm z)).symm

/-- The residue field at the transported prime is the rational prime field. -/
noncomputable def gaussianPrimeResidueEquiv
    (q : ℕ) [Fact q.Prime] (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt) (hπ0 : π ≠ 0) (hρπ : ρ π = 0) :
    (𝓞 GaussianField ⧸
      (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal) ≃+* ZMod q :=
  (fourthIntegerRingReduction q ρ).quotientKerEquivOfSurjective
    (ZMod.ringHom_surjective _)

@[simp] theorem gaussianPrimeResidueEquiv_mk
    (q : ℕ) [Fact q.Prime] (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt) (hπ0 : π ≠ 0) (hρπ : ρ π = 0)
    (z : GaussianInt) :
    gaussianPrimeResidueEquiv q ρ π hπ0 hρπ
      (Ideal.Quotient.mk
        (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal
        (gaussianFourthIntegerRingEquiv z)) = ρ z := by
  change (fourthIntegerRingReduction q ρ).quotientKerEquivOfSurjective
      (ZMod.ringHom_surjective _) (Ideal.Quotient.mk _
        (gaussianFourthIntegerRingEquiv z)) = ρ z
  rw [RingHom.quotientKerEquivOfSurjective_apply_mk]
  simp

theorem quarticGaussianLift_pow_four
    (q : ℕ) [Fact q.Prime] (χ : MulChar (ZMod q) ℂ)
    (hχ : orderOf χ = 4) (x : ZMod q) (hx : x ≠ 0) :
    quarticGaussianLift q χ hχ x ^ 4 = 1 := by
  have hχpow : χ ^ 4 = 1 := by simpa [hχ] using pow_orderOf_eq_one χ
  have hχx4 : (χ x) ^ 4 = 1 := by
    have hv := congrArg (fun φ : MulChar (ZMod q) ℂ => φ x) hχpow
    simpa [MulChar.pow_apply' χ (by decide : 4 ≠ 0),
      MulChar.one_apply (isUnit_iff_ne_zero.mpr hx)] using hv
  apply GaussianInt.toComplex_injective
  rw [map_pow, map_one, quarticGaussianLift_complex]
  exact hχx4

/-- The Gaussian lift of a nonzero quartic character value, considered
as a fourth root of unity in the cyclotomic integer ring. -/
noncomputable def quarticCharacterRootInFourthRing
    (q : ℕ) [Fact q.Prime] (χ : MulChar (ZMod q) ℂ)
    (hχ : orderOf χ = 4) (x : ZMod q) (hx : x ≠ 0) :
    rootsOfUnity 4 (𝓞 GaussianField) :=
  rootsOfUnity.mkOfPowEq
    (gaussianFourthIntegerRingEquiv (quarticGaussianLift q χ hχ x))
    (by rw [← map_pow, quarticGaussianLift_pow_four q χ hχ x hx, map_one])

@[simp] theorem quarticCharacterRootInFourthRing_val
    (q : ℕ) [Fact q.Prime] (χ : MulChar (ZMod q) ℂ)
    (hχ : orderOf χ = 4) (x : ZMod q) (hx : x ≠ 0) :
    (((quarticCharacterRootInFourthRing q χ hχ x hx :
        (𝓞 GaussianField)ˣ) : 𝓞 GaussianField)) =
      gaussianFourthIntegerRingEquiv (quarticGaussianLift q χ hχ x) := by
  simp [quarticCharacterRootInFourthRing]

/-- The ideal-theoretic fourth-power residue symbol at the transported
Gaussian prime is the same fourth root of unity as the finite-field
character selected by Gaussian reduction. -/
theorem gaussianQuarticPrimeSymbol_eq_quarticCharacterRoot
    (q : ℕ) [Fact q.Prime] (hqmod : q % 4 = 1)
    (ρ : GaussianInt →+* ZMod q) (π : GaussianInt)
    (hπ0 : π ≠ 0) (hρπ : ρ π = 0)
    (χ : MulChar (ZMod q) ℂ) (hχ : orderOf χ = 4)
    (hρchar : ∀ x : ZMod q,
      ρ (quarticGaussianLift q χ hχ x) = x ^ ((q - 1) / 4))
    (z : GaussianInt) (hz : ρ z ≠ 0)
    (h2 : (Ideal.absNorm
      (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal).Coprime 4) :
    gaussianQuarticPrimeSymbol
        (gaussianFourthIntegerRingEquiv z)
        (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ) h2
        (by
          intro hmem
          have hz0 : ρ z = 0 := by
            change gaussianFourthIntegerRingEquiv z ∈
              RingHom.ker (fourthIntegerRingReduction q ρ) at hmem
            simpa [RingHom.mem_ker] using hmem
          exact hz hz0) =
      quarticCharacterRootInFourthRing q χ hχ (ρ z) hz := by
  let P := gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ
  let R := gaussianFourthIntegerRingEquiv z
  let ζ := quarticCharacterRootInFourthRing q χ hχ (ρ z) hz
  letI : Fintype (𝓞 GaussianField ⧸ P.asIdeal) := Fintype.ofFinite _
  have hcard : Fintype.card (𝓞 GaussianField ⧸ P.asIdeal) = q := by
    rw [card_primeIdealResidueField GaussianField P]
    exact gaussianPrimeIdealOfReduction_absNorm q ρ π hπ0 hρπ
  have hn : 4 ∣ Fintype.card (𝓞 GaussianField ⧸ P.asIdeal) - 1 := by
    rw [hcard]
    omega
  have hR : R ∉ P.asIdeal := by
    intro hmem
    have hz0 : ρ z = 0 := by
      change gaussianFourthIntegerRingEquiv z ∈
        RingHom.ker (fourthIntegerRingReduction q ρ) at hmem
      simpa [RingHom.mem_ker] using hmem
    exact hz hz0
  have hsym := gaussianQuarticPrimeSymbol_reduction R P h2 hR
  apply rootsOfUnityReduction_injective GaussianField P ⟨4, by decide⟩ h2
  change rootsOfUnityReduction GaussianField P 4
      (gaussianQuarticPrimeSymbol R P h2 hR) =
    rootsOfUnityReduction GaussianField P 4 ζ
  change rootsOfUnityReduction GaussianField P 4
      (gaussianQuarticPrimeSymbol R P h2 hR) =
    finiteFieldPowerResidueSymbol
      (𝓞 GaussianField ⧸ P.asIdeal) ⟨4, by decide⟩ hn
      (primeIdealResidueUnit GaussianField P R hR) at hsym
  rw [hsym]
  apply Subtype.ext
  apply Units.ext
  change (primeIdealResidueUnit GaussianField P R hR :
      𝓞 GaussianField ⧸ P.asIdeal) ^
        ((Fintype.card (𝓞 GaussianField ⧸ P.asIdeal) - 1) / 4) =
    Ideal.Quotient.mk P.asIdeal (gaussianFourthIntegerRingEquiv
      (quarticGaussianLift q χ hχ (ρ z)))
  apply (gaussianPrimeResidueEquiv q ρ π hπ0 hρπ).injective
  simp [hcard, hρchar, gaussianPrimeResidueEquiv_mk,
    primeIdealResidueUnit, R, P]

/-- After the standard complex embedding, the prime-ideal symbol is the
ordinary quartic character of the rational residue. -/
theorem gaussianQuarticPrimeSymbol_complex_eq_character
    (q : ℕ) [Fact q.Prime] (hqmod : q % 4 = 1)
    (ρ : GaussianInt →+* ZMod q) (π : GaussianInt)
    (hπ0 : π ≠ 0) (hρπ : ρ π = 0)
    (χ : MulChar (ZMod q) ℂ) (hχ : orderOf χ = 4)
    (hρchar : ∀ x : ZMod q,
      ρ (quarticGaussianLift q χ hχ x) = x ^ ((q - 1) / 4))
    (z : GaussianInt) (hz : ρ z ≠ 0)
    (h2 : (Ideal.absNorm
      (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal).Coprime 4)
    (hR : gaussianFourthIntegerRingEquiv z ∉
      (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal) :
    fourthIntegerRingToComplex
        (((gaussianQuarticPrimeSymbol
            (gaussianFourthIntegerRingEquiv z)
            (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ) h2 hR :
            rootsOfUnity 4 (𝓞 GaussianField)) : (𝓞 GaussianField)ˣ) :
            𝓞 GaussianField) =
      χ (ρ z) := by
  have hsymbol := gaussianQuarticPrimeSymbol_eq_quarticCharacterRoot
    q hqmod ρ π hπ0 hρπ χ hχ hρchar z hz h2
  rw [hsymbol, quarticCharacterRootInFourthRing_val,
    fourthIntegerRingToComplex_gaussian, quarticGaussianLift_complex]

/-- The ideal symbol gives the same value at a principal prime denominator. -/
theorem gaussianQuarticIdealSymbol_complex_eq_character
    (q : ℕ) [Fact q.Prime] (hqmod : q % 4 = 1)
    (ρ : GaussianInt →+* ZMod q) (π : GaussianInt)
    (hπ0 : π ≠ 0) (hρπ : ρ π = 0)
    (χ : MulChar (ZMod q) ℂ) (hχ : orderOf χ = 4)
    (hρchar : ∀ x : ZMod q,
      ρ (quarticGaussianLift q χ hχ x) = x ^ ((q - 1) / 4))
    (z : GaussianInt) (hz : ρ z ≠ 0)
    (h2 : (Ideal.absNorm
      (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal).Coprime 4)
    (hR : gaussianFourthIntegerRingEquiv z ∉
      (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal) :
    fourthIntegerRingToComplex
        (((gaussianQuarticIdealSymbol
            (gaussianFourthIntegerRingEquiv z)
            (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal
            (gaussianQuarticGoodIdeal_prime
              (gaussianFourthIntegerRingEquiv z)
              (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ) h2 hR) :
            rootsOfUnity 4 (𝓞 GaussianField)) : (𝓞 GaussianField)ˣ) :
            𝓞 GaussianField) =
      χ (ρ z) := by
  rw [gaussianQuarticIdealSymbol_prime]
  exact gaussianQuarticPrimeSymbol_complex_eq_character
    q hqmod ρ π hπ0 hρπ χ hχ hρchar z hz h2 hR

/-- One split-prime witness simultaneously controls the Gaussian prime
ideal, its quartic ideal symbol, the Jacobi square, and the 21-term
point-count trace. -/
theorem exists_quartic_split_prime_symbol_trace
    (q : ℕ) [Fact q.Prime] (hqmod : q % 4 = 1)
    (π : GaussianInt) (hπnorm : π.norm = q)
    (hπre : (π.re : ZMod 2) = 1)
    (hπim : (π.im : ZMod 2) = 0)
    (ψ : AddChar (ZMod q) ℂ) (hψ : ψ.IsPrimitive)
    (a : Fin 4 → ZMod q) (ha : ∀ i, a i ≠ 0) :
    ∃ ρ : GaussianInt →+* ZMod q,
      ∃ hρπ : ρ π = 0,
        ∃ χ : MulChar (ZMod q) ℂ,
          ∃ hχ : orderOf χ = 4,
            (∀ z : GaussianInt, ρ z = 0 ↔ π ∣ z) ∧
            (∀ x : ZMod q,
              ρ (quarticGaussianLift q χ hχ x) = x ^ ((q - 1) / 4)) ∧
            jacobiSum χ χ ^ 2 = (π : ℂ) ^ 2 ∧
            (∀ z : GaussianInt, ∀ hz : ρ z ≠ 0,
              gaussianQuarticPrimeSymbol
                  (gaussianFourthIntegerRingEquiv z)
                  (gaussianPrimeIdealOfReduction q ρ π
                    (gaussianPrime_ne_zero_of_norm q π hπnorm) hρπ)
                  (gaussianPrimeIdealOfReduction_coprime_four q hqmod ρ π
                    (gaussianPrime_ne_zero_of_norm q π hπnorm) hρπ)
                  (gaussianPrimeIdealOfReduction_not_mem q ρ π
                    (gaussianPrime_ne_zero_of_norm q π hπnorm) hρπ z hz) =
                quarticCharacterRootInFourthRing q χ hχ (ρ z) hz) ∧
            ((q : ℂ) *
                (Nat.card {x : Fin 4 → ZMod q // ∑ i, a i * x i ^ 4 = 0} : ℂ) =
              (q : ℂ) ^ 4 + ((q - 1 : ℕ) : ℂ) *
                ∑ j ∈ quarticExponents,
                  ∏ i : Fin 4,
                    (χ ^ (j i : ℕ))⁻¹ (a i) *
                      gaussSum (χ ^ (j i : ℕ)) ψ) ∧
            quarticGaussTerm q χ ψ a (fun _ => 1) =
              χ⁻¹ (∏ i, a i) * ((π : ℂ) ^ 2 / (q : ℂ)) ∧
            quarticGaussTerm q χ ψ a (fun _ => 3) =
              χ (∏ i, a i) * (star (π : ℂ) ^ 2 / (q : ℂ)) := by
  obtain ⟨ρ, hker, χ, hχ, hρchar, hJ⟩ :=
    exists_quartic_residue_character_at_prime q hqmod π
      hπnorm hπre hπim
  have hπ0 := gaussianPrime_ne_zero_of_norm q π hπnorm
  have hρπ : ρ π = 0 := (hker π).2 (dvd_refl π)
  refine ⟨ρ, hρπ, χ, hχ, hker, hρchar, hJ, ?_, ?_, ?_, ?_⟩
  · intro z hz
    exact gaussianQuarticPrimeSymbol_eq_quarticCharacterRoot
      q hqmod ρ π hπ0 hρπ χ hχ hρchar z hz
      (gaussianPrimeIdealOfReduction_coprime_four q hqmod ρ π hπ0 hρπ)
  · exact quartic_zero_count_gauss_trace_q_sub_one q χ hχ ψ hψ a ha
  · rw [quarticGaussTerm_all_one q χ hχ ψ hψ a, hJ]
  · rw [quarticGaussTerm_all_three q χ hχ ψ hψ a]
    rw [← quartic_jacobi_conj q χ hχ, ← star_pow, hJ, star_pow]

/-- A split-prime quartic character realizes the normalized `(1,1,1,1)`
trace term by the square of the chosen Gaussian prime. -/
theorem exists_quartic_all_one_trace_at_gaussian_prime
    (q : ℕ) [Fact q.Prime] (hqmod : q % 4 = 1)
    (π : GaussianInt) (hπnorm : π.norm = q)
    (hπre : (π.re : ZMod 2) = 1)
    (hπim : (π.im : ZMod 2) = 0)
    (ψ : AddChar (ZMod q) ℂ) (hψ : ψ.IsPrimitive)
    (a : Fin 4 → ZMod q) :
    ∃ χ : MulChar (ZMod q) ℂ,
      orderOf χ = 4 ∧
      quarticGaussTerm q χ ψ a (fun _ => 1) =
        χ⁻¹ (∏ i, a i) * ((π : ℂ) ^ 2 / (q : ℂ)) := by
  obtain ⟨χ, hχ, hJ⟩ :=
    exists_quartic_character_jacobi_square_at_prime q hqmod π
      hπnorm hπre hπim
  refine ⟨χ, hχ, ?_⟩
  rw [quarticGaussTerm_all_one q χ hχ ψ hψ a, hJ]

/-- For the same character, the conjugate `(3,3,3,3)` summand is
the square of the conjugate Gaussian prime. -/
theorem quartic_all_three_trace_of_jacobi_square
    (q : ℕ) [Fact q.Prime]
    (χ : MulChar (ZMod q) ℂ) (hχ : orderOf χ = 4)
    (π : GaussianInt) (hJ : jacobiSum χ χ ^ 2 = (π : ℂ) ^ 2)
    (ψ : AddChar (ZMod q) ℂ) (hψ : ψ.IsPrimitive)
    (a : Fin 4 → ZMod q) :
    quarticGaussTerm q χ ψ a (fun _ => 3) =
      χ (∏ i, a i) * (star (π : ℂ) ^ 2 / (q : ℂ)) := by
  rw [quarticGaussTerm_all_three q χ hχ ψ hψ a]
  rw [← quartic_jacobi_conj q χ hχ]
  rw [← star_pow, hJ, star_pow]

/-- A single quartic residue character supplies the complete 21-term
trace and the CM evaluations of its two exceptional summands. -/
theorem exists_quartic_trace_at_gaussian_prime
    (q : ℕ) [Fact q.Prime] (hqmod : q % 4 = 1)
    (π : GaussianInt) (hπnorm : π.norm = q)
    (hπre : (π.re : ZMod 2) = 1)
    (hπim : (π.im : ZMod 2) = 0)
    (ψ : AddChar (ZMod q) ℂ) (hψ : ψ.IsPrimitive)
    (a : Fin 4 → ZMod q) (ha : ∀ i, a i ≠ 0) :
    ∃ χ : MulChar (ZMod q) ℂ,
      orderOf χ = 4 ∧
      ((q : ℂ) *
          (Nat.card {x : Fin 4 → ZMod q // ∑ i, a i * x i ^ 4 = 0} : ℂ) =
        (q : ℂ) ^ 4 + ((q - 1 : ℕ) : ℂ) *
          ∑ j ∈ quarticExponents,
            ∏ i : Fin 4,
              (χ ^ (j i : ℕ))⁻¹ (a i) * gaussSum (χ ^ (j i : ℕ)) ψ) ∧
      quarticGaussTerm q χ ψ a (fun _ => 2) = (χ ^ 2) (∏ i, a i) ∧
      quarticGaussTerm q χ ψ a (fun _ => 1) =
        χ⁻¹ (∏ i, a i) * ((π : ℂ) ^ 2 / (q : ℂ)) ∧
      quarticGaussTerm q χ ψ a (fun _ => 3) =
        χ (∏ i, a i) * (star (π : ℂ) ^ 2 / (q : ℂ)) ∧
      quarticGaussTerm q χ ψ a quarticPairExponent =
        χ (a 0 ^ 3 * a 1 ^ 3 * a 2 * a 3) ∧
      quarticGaussTerm q χ ψ a quarticMixedExponent =
        χ (-(a 0 ^ 3 * a 1 * a 2 ^ 2 * a 3 ^ 2)) := by
  obtain ⟨χ, hχ, hJ⟩ :=
    exists_quartic_character_jacobi_square_at_prime q hqmod π
      hπnorm hπre hπim
  refine ⟨χ, hχ, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact quartic_zero_count_gauss_trace_q_sub_one q χ hχ ψ hψ a ha
  · exact quarticGaussTerm_all_two q χ hχ ψ hψ a
  · rw [quarticGaussTerm_all_one q χ hχ ψ hψ a, hJ]
  · exact quartic_all_three_trace_of_jacobi_square q χ hχ π hJ ψ hψ a
  · exact quarticGaussTerm_pair_canonical q χ hχ ψ hψ a
  · exact quarticGaussTerm_mixed_canonical q χ hχ ψ hψ a

end Erdos940.Quartic
