import Erdos940.Quartic.GaussianHeckeLBridge
import Mathlib.LinearAlgebra.Basis.Defs
import Mathlib.NumberTheory.LSeries.Linearity
import Mathlib.RingTheory.Ideal.IsPrincipal
import Mathlib.RingTheory.Norm.Basic

/-!
# Ideal and lattice-generator series in the Gaussian integers

Every nonzero ideal of `ℤ[i]` is principal, and every nonzero principal ideal
has exactly four generators. This accounts for the factor four between the
ideal Dirichlet series and the unrestricted Gaussian-lattice series.
-/

namespace Erdos940.Quartic.GaussianIdealLatticeSeries

open scoped NumberField
open Module
open Erdos940.Quartic.GaussianHeckeLBridge
open Erdos940.Quartic.GaussianCoefficientLBound

/-- A Gaussian integer has exactly the four familiar unit multiples when
its principal ideal is fixed and it is nonzero. -/
theorem gaussian_unit_eq_four (u : GaussianIntˣ) :
    (u : GaussianInt) = 1 ∨ (u : GaussianInt) = -1 ∨
      (u : GaussianInt) = Zsqrtd.sqrtd ∨
      (u : GaussianInt) = -Zsqrtd.sqrtd := by
  have hnorm : (u : GaussianInt).norm = 1 :=
    (Zsqrtd.norm_eq_one_iff' (by decide : (-1 : ℤ) ≤ 0) _).mpr u.isUnit
  have hsquares : (u : GaussianInt).re ^ 2 + (u : GaussianInt).im ^ 2 = 1 := by
    simpa [Zsqrtd.norm, pow_two] using hnorm
  have hre_nonneg : 0 ≤ (u : GaussianInt).re ^ 2 := sq_nonneg _
  have him_nonneg : 0 ≤ (u : GaussianInt).im ^ 2 := sq_nonneg _
  have hcase : (u : GaussianInt).re ^ 2 = 0 ∨
      (u : GaussianInt).im ^ 2 = 0 := by omega
  rcases hcase with hre | him
  · have hre0 : (u : GaussianInt).re = 0 := by nlinarith
    have himsq : (u : GaussianInt).im ^ 2 = 1 := by omega
    have him1 : (u : GaussianInt).im = 1 ∨ (u : GaussianInt).im = -1 :=
      sq_eq_one_iff.mp himsq
    rcases him1 with hi | hi
    · right; right; left
      ext <;> simp [hre0, hi]
    · right; right; right
      ext <;> simp [hre0, hi]
  · have him0 : (u : GaussianInt).im = 0 := by nlinarith
    have hresq : (u : GaussianInt).re ^ 2 = 1 := by omega
    have hre1 : (u : GaussianInt).re = 1 ∨ (u : GaussianInt).re = -1 :=
      sq_eq_one_iff.mp hresq
    rcases hre1 with hr | hr
    · left
      ext <;> simp [him0, hr]
    · right; left
      ext <;> simp [him0, hr]

private def gaussianUnitValues : Finset GaussianInt :=
  {1, -1, Zsqrtd.sqrtd, -Zsqrtd.sqrtd}

private theorem gaussianUnitValues_mem (u : GaussianIntˣ) :
    (u : GaussianInt) ∈ gaussianUnitValues := by
  rcases gaussian_unit_eq_four u with h | h | h | h <;>
    simp [gaussianUnitValues, h]

private theorem gaussianUnitValues_isUnit (z : GaussianInt)
    (hz : z ∈ gaussianUnitValues) : IsUnit z := by
  simp only [gaussianUnitValues, Finset.mem_insert, Finset.mem_singleton] at hz
  rcases hz with h | h | h | h <;> subst z
  all_goals
    apply (Zsqrtd.norm_eq_one_iff' (by decide : (-1 : ℤ) ≤ 0) _).mp
    norm_num [Zsqrtd.norm]

/-- Gaussian units are precisely `1`, `-1`, `i`, and `-i`. -/
private noncomputable def gaussianUnitsEquiv :
    GaussianIntˣ ≃ {z : GaussianInt // z ∈ gaussianUnitValues} where
  toFun u := ⟨u, gaussianUnitValues_mem u⟩
  invFun z := (gaussianUnitValues_isUnit z.1 z.2).unit
  left_inv _ := Units.ext rfl
  right_inv _ := Subtype.ext rfl

private noncomputable instance : Fintype GaussianIntˣ :=
  Fintype.ofEquiv _ gaussianUnitsEquiv.symm

theorem gaussian_units_card_four : Fintype.card GaussianIntˣ = 4 := by
  classical
  have hcard : gaussianUnitValues.card = 4 := by
    decide
  calc
    Fintype.card GaussianIntˣ =
        Fintype.card {z : GaussianInt // z ∈ gaussianUnitValues} :=
      Fintype.card_congr gaussianUnitsEquiv
    _ = gaussianUnitValues.card := Fintype.card_coe _
    _ = 4 := hcard

/-- The principal ideal in the fourth cyclotomic integer ring generated by a
Gaussian integer. -/
noncomputable def gaussianPrincipalIdeal (z : GaussianInt) :
    Ideal (𝓞 GaussianField) :=
  Ideal.span {gaussianFourthIntegerRingEquiv z}

/-- Two Gaussian integers generate the same ideal exactly when they differ
by a Gaussian unit. -/
theorem gaussianPrincipalIdeal_eq_iff_associated (z w : GaussianInt) :
    gaussianPrincipalIdeal w = gaussianPrincipalIdeal z ↔
      ∃ u : GaussianIntˣ, z * (u : GaussianInt) = w := by
  unfold gaussianPrincipalIdeal
  constructor
  · intro h
    have ha : Associated (gaussianFourthIntegerRingEquiv z)
        (gaussianFourthIntegerRingEquiv w) :=
      (Ideal.span_singleton_eq_span_singleton.mp h).symm
    obtain ⟨u, hu⟩ := ha
    refine ⟨u.map gaussianFourthIntegerRingEquiv.symm.toMonoidHom, ?_⟩
    have hu' := congrArg gaussianFourthIntegerRingEquiv.symm hu
    simpa using hu'
  · rintro ⟨u, hu⟩
    have ha : Associated (gaussianFourthIntegerRingEquiv z)
        (gaussianFourthIntegerRingEquiv w) := by
      refine ⟨u.map gaussianFourthIntegerRingEquiv.toMonoidHom, ?_⟩
      simpa [← hu, map_mul] using
        congrArg gaussianFourthIntegerRingEquiv hu
    exact (Ideal.span_singleton_eq_span_singleton.mpr ha.symm)

/-- Each nonzero principal ideal has its generators parametrized by the
four Gaussian units. -/
private noncomputable def gaussianIdealGeneratorsEquiv
    (z : GaussianInt) (hz : z ≠ 0) :
    GaussianIntˣ ≃
      {w : GaussianInt // gaussianPrincipalIdeal w = gaussianPrincipalIdeal z} :=
  Equiv.ofBijective
    (fun u : GaussianIntˣ =>
      ⟨z * (u : GaussianInt),
        (gaussianPrincipalIdeal_eq_iff_associated z _).mpr ⟨u, rfl⟩⟩)
    ⟨by
      intro u v huv
      apply Units.ext
      exact mul_left_cancel₀ hz (congrArg Subtype.val huv),
     by
      rintro ⟨w, hw⟩
      obtain ⟨u, hu⟩ := (gaussianPrincipalIdeal_eq_iff_associated z w).mp hw
      exact ⟨u, Subtype.ext hu⟩⟩

theorem gaussian_ideal_generator_card_four
    (z : GaussianInt) (hz : z ≠ 0) :
    @Fintype.card
      {w : GaussianInt // gaussianPrincipalIdeal w = gaussianPrincipalIdeal z}
      (Fintype.ofEquiv _ (gaussianIdealGeneratorsEquiv z hz)) = 4 := by
  letI : Fintype
      {w : GaussianInt // gaussianPrincipalIdeal w = gaussianPrincipalIdeal z} :=
    Fintype.ofEquiv _ (gaussianIdealGeneratorsEquiv z hz)
  change Fintype.card
    {w : GaussianInt // gaussianPrincipalIdeal w = gaussianPrincipalIdeal z} = 4
  rw [← Fintype.card_congr (gaussianIdealGeneratorsEquiv z hz)]
  exact gaussian_units_card_four

/-- Summing an ideal-dependent weight over all generators of a fixed nonzero
principal ideal multiplies its value by four. -/
theorem gaussian_ideal_generator_sum_four
    (z : GaussianInt) (hz : z ≠ 0)
    (f : Ideal (𝓞 GaussianField) → ℂ) :
    letI : Fintype
        {w : GaussianInt // gaussianPrincipalIdeal w = gaussianPrincipalIdeal z} :=
      Fintype.ofEquiv _ (gaussianIdealGeneratorsEquiv z hz)
    (∑ w : {w : GaussianInt // gaussianPrincipalIdeal w = gaussianPrincipalIdeal z},
      f (gaussianPrincipalIdeal w.1)) = 4 * f (gaussianPrincipalIdeal z) := by
  classical
  letI : Fintype
      {w : GaussianInt // gaussianPrincipalIdeal w = gaussianPrincipalIdeal z} :=
    Fintype.ofEquiv _ (gaussianIdealGeneratorsEquiv z hz)
  simp_rw [show ∀ w : {w : GaussianInt // gaussianPrincipalIdeal w = gaussianPrincipalIdeal z},
      gaussianPrincipalIdeal w.1 = gaussianPrincipalIdeal z from fun w => w.property]
  simp [gaussian_ideal_generator_card_four z hz, nsmul_eq_mul]

/-- The lattice squared norm is the usual Gaussian algebraic norm. -/
theorem gaussianNormSq_coordinates (z : GaussianInt) :
    gaussianNormSq (z.re, z.im) = z.norm.natAbs := by
  have h : ((gaussianNormSq (z.re, z.im) : ℕ) : ℤ) = z.norm := by
    rw [gaussianNormSq_cast]
    simp [Zsqrtd.norm, pow_two]
  rw [← GaussianInt.abs_natCast_norm z] at h
  exact_mod_cast h

/-- Associated Gaussian integers lie on the same norm shell. -/
theorem gaussianNormSq_of_same_ideal (z w : GaussianInt)
    (h : gaussianPrincipalIdeal w = gaussianPrincipalIdeal z) :
    gaussianNormSq (w.re, w.im) = gaussianNormSq (z.re, z.im) := by
  obtain ⟨u, hu⟩ := (gaussianPrincipalIdeal_eq_iff_associated z w).mp h
  rw [gaussianNormSq_coordinates w, gaussianNormSq_coordinates z, ← hu,
    Zsqrtd.norm_mul, Int.natAbs_mul]
  have huNorm : (u : GaussianInt).norm.natAbs = 1 :=
    Zsqrtd.norm_eq_one_iff.mpr u.isUnit
  simp [huNorm]

private def gaussianCoordinatesEquiv : (ℤ × ℤ) ≃ GaussianInt where
  toFun p := ⟨p.1, p.2⟩
  invFun z := (z.re, z.im)
  left_inv p := rfl
  right_inv z := by cases z; rfl

/-- The finite shell of Gaussian integers of squared norm `n`. -/
noncomputable def gaussianIntegerNormShell (n : ℕ) : Finset GaussianInt :=
  (gaussianNormShell n).map gaussianCoordinatesEquiv.toEmbedding

theorem mem_gaussianIntegerNormShell_iff (n : ℕ) (z : GaussianInt) :
    z ∈ gaussianIntegerNormShell n ↔ gaussianNormSq (z.re, z.im) = n := by
  simp [gaussianIntegerNormShell, gaussianCoordinatesEquiv,
    mem_gaussianNormShell_iff]

theorem mem_gaussianIntegerNormShell_of_same_ideal (n : ℕ)
    (z w : GaussianInt) (hz : z ∈ gaussianIntegerNormShell n)
    (h : gaussianPrincipalIdeal w = gaussianPrincipalIdeal z) :
    w ∈ gaussianIntegerNormShell n := by
  rw [mem_gaussianIntegerNormShell_iff,
    gaussianNormSq_of_same_ideal z w h]
  exact (mem_gaussianIntegerNormShell_iff n z).mp hz

/-- The ideal image of the Gaussian norm shell. -/
noncomputable def gaussianIdealNormShell (n : ℕ) :
    Finset (Ideal (𝓞 GaussianField)) :=
  (gaussianIntegerNormShell n).image gaussianPrincipalIdeal

theorem gaussianIntegerNormShell_ne_zero (n : ℕ) (hn : 0 < n)
    (z : GaussianInt) (hz : z ∈ gaussianIntegerNormShell n) : z ≠ 0 := by
  intro hzero
  subst z
  have hnorm := (mem_gaussianIntegerNormShell_iff n 0).mp hz
  simp [gaussianNormSq] at hnorm
  omega

/-- The fiber in a positive norm shell over one of its principal ideals is
the image of the four Gaussian units. -/
private theorem gaussianIntegerNormShell_ideal_fiber
    (n : ℕ) (z : GaussianInt) (hz : z ∈ gaussianIntegerNormShell n) :
    (gaussianIntegerNormShell n).filter
        (fun w => gaussianPrincipalIdeal w = gaussianPrincipalIdeal z) =
      Finset.univ.image (fun u : GaussianIntˣ => z * (u : GaussianInt)) := by
  classical
  ext w
  simp only [Finset.mem_filter, Finset.mem_image, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨_, hideal⟩
    obtain ⟨u, hu⟩ := (gaussianPrincipalIdeal_eq_iff_associated z w).mp hideal
    exact ⟨u, hu⟩
  · rintro ⟨u, rfl⟩
    have hideal : gaussianPrincipalIdeal (z * (u : GaussianInt)) =
        gaussianPrincipalIdeal z :=
      (gaussianPrincipalIdeal_eq_iff_associated z _).mpr ⟨u, rfl⟩
    exact ⟨mem_gaussianIntegerNormShell_of_same_ideal n z _ hz hideal,
      hideal⟩

theorem gaussianIntegerNormShell_ideal_fiber_card_four
    (n : ℕ) (hn : 0 < n)
    (z : GaussianInt) (hz : z ∈ gaussianIntegerNormShell n) :
    ((gaussianIntegerNormShell n).filter
      (fun w => gaussianPrincipalIdeal w = gaussianPrincipalIdeal z)).card = 4 := by
  classical
  rw [gaussianIntegerNormShell_ideal_fiber n z hz]
  have hinj : Function.Injective (fun u : GaussianIntˣ => z * (u : GaussianInt)) := by
    intro u v huv
    apply Units.ext
    exact mul_left_cancel₀ (gaussianIntegerNormShell_ne_zero n hn z hz) huv
  rw [Finset.card_image_of_injective _ hinj, Finset.card_univ]
  exact gaussian_units_card_four

/-- The unrestricted Gaussian lattice sum is four times the sum over its
principal-ideal image, at every positive squared norm. This is the exact
coefficient-level unit quotient, independent of the character chosen. -/
theorem gaussian_shell_sum_eq_four_ideal_sum
    (n : ℕ) (hn : 0 < n) (f : Ideal (𝓞 GaussianField) → ℂ) :
    (∑ z ∈ gaussianIntegerNormShell n, f (gaussianPrincipalIdeal z)) =
      4 * ∑ I ∈ gaussianIdealNormShell n, f I := by
  classical
  let s := gaussianIntegerNormShell n
  let t := gaussianIdealNormShell n
  have hgroup : (∑ I ∈ t,
      ∑ z ∈ s with gaussianPrincipalIdeal z = I,
        f (gaussianPrincipalIdeal z)) =
      ∑ z ∈ s, f (gaussianPrincipalIdeal z) :=
    Finset.sum_fiberwise_of_maps_to
      (fun z hz => Finset.mem_image_of_mem gaussianPrincipalIdeal hz) _
  calc
    (∑ z ∈ s, f (gaussianPrincipalIdeal z)) =
        ∑ I ∈ t, ∑ z ∈ s with gaussianPrincipalIdeal z = I,
          f (gaussianPrincipalIdeal z) := hgroup.symm
    _ = ∑ I ∈ t, 4 * f I := by
      apply Finset.sum_congr rfl
      intro I hI
      obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hI
      have hc := gaussianIntegerNormShell_ideal_fiber_card_four n hn z hz
      calc
        (∑ w ∈ s with gaussianPrincipalIdeal w = gaussianPrincipalIdeal z,
            f (gaussianPrincipalIdeal w)) =
            ∑ w ∈ s with gaussianPrincipalIdeal w = gaussianPrincipalIdeal z,
              f (gaussianPrincipalIdeal z) := by
          apply Finset.sum_congr rfl
          intro w hw
          exact congrArg f (Finset.mem_filter.mp hw).2
        _ = 4 * f (gaussianPrincipalIdeal z) := by
          simp [s, hc, nsmul_eq_mul]
    _ = 4 * ∑ I ∈ t, f I := by rw [Finset.mul_sum]

/-- An ideal-dependent weight, extended by zero off the good quartic ideals. -/
noncomputable def quarticIdealWeight
    (R : 𝓞 GaussianField) (ι : GaussianField →+* ℂ)
    (I : Ideal (𝓞 GaussianField)) : ℂ := by
  classical
  exact if h : GaussianQuarticGoodIdeal R I then
    gaussianQuarticComplexValue ι (gaussianQuarticIdealSymbol R I h)
  else 0

theorem norm_quarticIdealWeight_le_one
    (R : 𝓞 GaussianField) (ι : GaussianField →+* ℂ)
    (I : Ideal (𝓞 GaussianField)) :
    ‖quarticIdealWeight R ι I‖ ≤ 1 := by
  classical
  unfold quarticIdealWeight
  split_ifs with h
  · exact le_of_eq (norm_gaussianQuarticComplexValue ι _)
  · simp

theorem quarticIdealLatticeWeight_eq_idealWeight
    (R : 𝓞 GaussianField) (ι : GaussianField →+* ℂ)
    (p : ℤ × ℤ) :
    quarticIdealLatticeWeight R ι p =
      quarticIdealWeight R ι
        (gaussianPrincipalIdeal (gaussianCoordinatesEquiv p)) := by
  rfl

/-- Reindex the pair-valued norm shell by Gaussian integers. -/
theorem gaussianNormShell_sum_eq_integerShell
    (n : ℕ) (f : GaussianInt → ℂ) :
    (∑ p ∈ gaussianNormShell n, f (gaussianCoordinatesEquiv p)) =
      ∑ z ∈ gaussianIntegerNormShell n, f z := by
  simp [gaussianIntegerNormShell]

/-- The concrete quartic lattice coefficient is four times the ideal
coefficient over its principal-ideal image. -/
theorem quarticIdealZeroCoeff_eq_four_idealCoeff
    (n : ℕ) (hn : 0 < n)
    (R : 𝓞 GaussianField) (ι : GaussianField →+* ℂ) :
    gaussianZeroWeightCoeff (quarticIdealLatticeWeight R ι) n =
      4 * ∑ I ∈ gaussianIdealNormShell n, quarticIdealWeight R ι I := by
  unfold gaussianZeroWeightCoeff
  simp_rw [quarticIdealLatticeWeight_eq_idealWeight]
  calc
    (∑ p ∈ gaussianNormShell n,
        quarticIdealWeight R ι
          (gaussianPrincipalIdeal (gaussianCoordinatesEquiv p))) =
        ∑ z ∈ gaussianIntegerNormShell n,
          quarticIdealWeight R ι (gaussianPrincipalIdeal z) :=
      gaussianNormShell_sum_eq_integerShell n
        (fun z => quarticIdealWeight R ι (gaussianPrincipalIdeal z))
    _ = 4 * ∑ I ∈ gaussianIdealNormShell n, quarticIdealWeight R ι I :=
      gaussian_shell_sum_eq_four_ideal_sum n hn (quarticIdealWeight R ι)

/-- The coordinate equivalence furnishing the standard integral basis of
`ℤ[i]`. -/
private def gaussianCoordLinearEquiv :
    GaussianInt ≃ₗ[ℤ] (Fin 2 → ℤ) where
  toFun z i := if i = 0 then z.re else z.im
  invFun v := ⟨v 0, v 1⟩
  left_inv z := by
    ext <;> simp
  right_inv v := by
    funext i
    fin_cases i <;> simp
  map_add' z w := by
    funext i
    fin_cases i <;> simp [Zsqrtd.re_add, Zsqrtd.im_add]
  map_smul' r z := by
    funext i
    fin_cases i <;> simp

private noncomputable def gaussianIntegralBasis : Basis (Fin 2) ℤ GaussianInt :=
  Basis.ofEquivFun gaussianCoordLinearEquiv

private theorem gaussianIntegralBasis_zero :
    gaussianIntegralBasis 0 = 1 := by
  apply gaussianCoordLinearEquiv.injective
  funext i
  fin_cases i <;>
    simp [gaussianIntegralBasis, Basis.coe_ofEquivFun,
      gaussianCoordLinearEquiv]

private theorem gaussianIntegralBasis_one :
    gaussianIntegralBasis 1 = Zsqrtd.sqrtd := by
  apply gaussianCoordLinearEquiv.injective
  funext i
  fin_cases i <;>
    simp [gaussianIntegralBasis, Basis.coe_ofEquivFun,
      gaussianCoordLinearEquiv]

private theorem algebra_norm_gaussian (z : GaussianInt) :
    Algebra.norm ℤ z = z.norm := by
  rw [Algebra.norm_eq_matrix_det gaussianIntegralBasis z, Matrix.det_fin_two]
  simp [Algebra.leftMulMatrix_eq_repr_mul,
    gaussianIntegralBasis, Basis.ofEquivFun_repr_apply,
    gaussianCoordLinearEquiv, Zsqrtd.norm]

private noncomputable def gaussianIntegerAlgEquiv :
    GaussianInt ≃ₐ[ℤ] 𝓞 GaussianField :=
  AlgEquiv.ofRingEquiv (f := gaussianFourthIntegerRingEquiv)
    (by intro n; simp)

/-- The norm of a Gaussian principal ideal is the squared Euclidean norm
of its generator. -/
theorem absNorm_gaussianPrincipalIdeal (z : GaussianInt) :
    (gaussianPrincipalIdeal z).absNorm = z.norm.natAbs := by
  rw [gaussianPrincipalIdeal, Ideal.absNorm_span_singleton]
  have h := Algebra.norm_eq_of_algEquiv gaussianIntegerAlgEquiv z
  simpa [gaussianIntegerAlgEquiv, algebra_norm_gaussian] using congrArg Int.natAbs h

noncomputable instance gaussianFourthIsPrincipalIdealRing :
    IsPrincipalIdealRing (𝓞 GaussianField) :=
  IsPrincipalIdealRing.of_surjective gaussianFourthIntegerRingEquiv.toRingHom
    gaussianFourthIntegerRingEquiv.surjective

/-- All ideals of a prescribed absolute norm in the Gaussian integer ring. -/
noncomputable def gaussianAllIdealNormShell (n : ℕ) :
    Finset (Ideal (𝓞 GaussianField)) :=
  (Ideal.finite_setOfPred_absNorm_eq n).toFinset

theorem mem_gaussianAllIdealNormShell_iff (n : ℕ)
    (I : Ideal (𝓞 GaussianField)) :
    I ∈ gaussianAllIdealNormShell n ↔ I.absNorm = n := by
  simp [gaussianAllIdealNormShell]

/-- Since `ℤ[i]` is a PID, the ideal image of a positive Gaussian lattice
norm shell is precisely the full absolute-norm shell of ideals. -/
theorem gaussianIdealNormShell_eq_all (n : ℕ) :
    gaussianIdealNormShell n = gaussianAllIdealNormShell n := by
  classical
  ext I
  rw [mem_gaussianAllIdealNormShell_iff]
  constructor
  · intro hI
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hI
    rw [absNorm_gaussianPrincipalIdeal, ← gaussianNormSq_coordinates]
    exact (mem_gaussianIntegerNormShell_iff n z).mp hz
  · intro hI
    obtain ⟨a, ha⟩ := IsPrincipalIdealRing.principal I
    let z := gaussianFourthIntegerRingEquiv.symm a
    have heq : gaussianPrincipalIdeal z = I := by
      change Ideal.span {gaussianFourthIntegerRingEquiv z} = I
      simpa [z] using ha.symm
    refine Finset.mem_image.mpr ⟨z, ?_, heq⟩
    rw [mem_gaussianIntegerNormShell_iff, gaussianNormSq_coordinates,
      ← absNorm_gaussianPrincipalIdeal, heq]
    exact hI

/-- Norm-indexed coefficients of the quartic ideal Dirichlet series. The
zero-index coefficient is set to zero, as usual for a Dirichlet series. -/
noncomputable def quarticIdealCoeff
    (R : 𝓞 GaussianField) (ι : GaussianField →+* ℂ) (n : ℕ) : ℂ :=
  if n = 0 then 0 else
    ∑ I ∈ gaussianAllIdealNormShell n, quarticIdealWeight R ι I

theorem quarticIdealZeroCoeff_eq_four_fullIdealCoeff
    (R : 𝓞 GaussianField) (ι : GaussianField →+* ℂ) (n : ℕ) :
    gaussianZeroWeightCoeff (quarticIdealLatticeWeight R ι) n =
      4 * quarticIdealCoeff R ι n := by
  by_cases hn : n = 0
  · subst n
    have hs : gaussianNormShell 0 = {(0, 0)} := by
      ext p
      rw [mem_gaussianNormShell_iff, gaussianNormSq_eq_zero_iff]
      simp
    simp [gaussianZeroWeightCoeff, hs, quarticIdealCoeff,
      quarticIdealLatticeWeight_origin]
  · have hpos : 0 < n := Nat.pos_of_ne_zero hn
    rw [quarticIdealZeroCoeff_eq_four_idealCoeff n hpos,
      gaussianIdealNormShell_eq_all n]
    simp [quarticIdealCoeff, hn]

/-- Exact factor-four relation between the unrestricted Gaussian generator
`L`-series and the quartic ideal `L`-series. -/
theorem quarticIdealZeroLSeries_eq_four_idealLSeries
    (R : 𝓞 GaussianField) (ι : GaussianField →+* ℂ) (s : ℂ) :
    LSeries (gaussianZeroWeightCoeff (quarticIdealLatticeWeight R ι)) s =
      4 * LSeries (quarticIdealCoeff R ι) s := by
  have hcoeff : gaussianZeroWeightCoeff (quarticIdealLatticeWeight R ι) =
      (4 : ℂ) • quarticIdealCoeff R ι := by
    funext n
    simpa [Pi.smul_apply] using quarticIdealZeroCoeff_eq_four_fullIdealCoeff R ι n
  rw [hcoeff, LSeries_smul]

/-- The existing zero-type lattice estimate bounds the corresponding
Gaussian ideal-character `L`-series, with the four generators divided out. -/
theorem norm_quarticIdealLSeries_le_log
    (q : ℕ) [NeZero q] (R : 𝓞 GaussianField)
    (ι : GaussianField →+* ℂ)
    (hperiod : PeriodicGaussianWeight q (quarticIdealLatticeWeight R ι))
    (hmean : (∑ uv : Fin q × Fin q,
      residueWeight q (quarticIdealLatticeWeight R ι) uv) = 0)
    (σ : ℝ) (hσ₁ : 1 < σ) (hσ₂ : σ ≤ 2) :
    ‖LSeries (quarticIdealCoeff R ι) (σ : ℂ)‖ ≤
      (162 * Real.log ((q : ℝ) ^ 2) + 648) / 4 := by
  have h := norm_quarticIdealZeroLSeries_le_log q R ι
    hperiod hmean σ hσ₁ hσ₂
  rw [quarticIdealZeroLSeries_eq_four_idealLSeries, norm_mul] at h
  have hfour : ‖(4 : ℂ)‖ = (4 : ℝ) := by norm_num
  rw [hfour] at h
  linarith

end Erdos940.Quartic.GaussianIdealLatticeSeries
