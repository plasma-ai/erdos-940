/-!
# Finite prime selection for the quartic complement argument

Section 4 of the quartic proof selects primes from finitely many disjoint
Chebotarev fibers. The analytic input is divergence of the reciprocal-prime
sum in each fiber. This module proves the finite selection and budget step
for those fibers, including a simultaneous bound for every character in a
finite family.
-/

namespace Erdos940.Quartic

open Filter NumberField Topology
open scoped Classical

/-- A single finite Galois extension containing `i` and square roots of all
members of the coefficient family. -/
noncomputable def quarticCharacterPolynomial (E : Finset ℕ) : Polynomial ℚ :=
  (Polynomial.X ^ 2 + 1) *
    E.prod (fun d => Polynomial.X ^ 2 - Polynomial.C (d : ℚ))

abbrev QuarticCharacterField (E : Finset ℕ) :=
  (quarticCharacterPolynomial E).SplittingField

private instance (E : Finset ℕ) : NumberField (QuarticCharacterField E) := by
  letI : FiniteDimensional ℚ (QuarticCharacterField E) :=
    Polynomial.IsSplittingField.finiteDimensional
      (QuarticCharacterField E) (quarticCharacterPolynomial E)
  exact NumberField.of_module_finite ℚ (QuarticCharacterField E)

private instance (E : Finset ℕ) : IsGalois ℚ (QuarticCharacterField E) := by
  haveI : Algebra.IsSeparable ℚ (QuarticCharacterField E) := inferInstance
  exact isGalois_iff.mpr
    ⟨inferInstance, Normal.of_isSplittingField (quarticCharacterPolynomial E)⟩

/-- A splitting field generated by elements whose squares lie in the base
field has Galois group of exponent two, hence an abelian Galois group. -/
private theorem galoisGroup_comm_of_quadratic_rootSet
    (L : Type*) [Field L] [Algebra ℚ L]
    (p : Polynomial ℚ) [Polynomial.IsSplittingField ℚ L p]
    (hroot : ∀ r ∈ p.rootSet L, ∃ c : ℚ,
      r ^ 2 = algebraMap ℚ L c) :
    IsMulCommutative Gal(L/ℚ) := by
  have hpow (σ : Gal(L/ℚ)) : σ ^ 2 = 1 := by
    apply AlgEquiv.ext
    intro x
    have hx : x ∈ Algebra.adjoin ℚ (p.rootSet L) := by
      rw [Polynomial.IsSplittingField.adjoin_rootSet L p]
      trivial
    induction hx using Algebra.adjoin_induction with
    | mem r hr =>
      obtain ⟨c, hc⟩ := hroot r hr
      have hsq : (σ r) ^ 2 = r ^ 2 := by
        calc
          (σ r) ^ 2 = σ (r ^ 2) := by simp
          _ = σ (algebraMap ℚ L c) := by rw [hc]
          _ = algebraMap ℚ L c := σ.commutes c
          _ = r ^ 2 := hc.symm
      rcases eq_or_eq_neg_of_sq_eq_sq (σ r) r hsq with hsame | hneg
      · simp [pow_two, AlgEquiv.mul_apply, hsame]
      · simp [pow_two, AlgEquiv.mul_apply, hneg]
    | algebraMap c => simp
    | add x y hx hy ihx ihy =>
      change σ (σ x) = x at ihx
      change σ (σ y) = y at ihy
      simpa [ihx, ihy]
    | mul x y hx hy ihx ihy =>
      change σ (σ x) = x at ihx
      change σ (σ y) = y at ihy
      simpa [ihx, ihy]
  apply IsMulCommutative.of_comm
  intro σ τ
  exact (Commute.of_orderOf_dvd_two
    (fun g => (orderOf_dvd_iff_pow_eq_one).2 (hpow g)) σ τ).eq

private theorem quarticCharacterPolynomial_monic (E : Finset ℕ) :
    (quarticCharacterPolynomial E).Monic := by
  unfold quarticCharacterPolynomial
  exact (Polynomial.monic_X_pow_add_C (1 : ℚ) (by decide)).mul
    (Polynomial.monic_prod_of_monic E _ (fun d _ =>
      Polynomial.monic_X_pow_sub_C (d : ℚ) (by decide)))

private theorem quarticCharacterPolynomial_root_sq
    (E : Finset ℕ) (r : QuarticCharacterField E)
    (hr : r ∈ (quarticCharacterPolynomial E).rootSet
      (QuarticCharacterField E)) :
    ∃ c : ℚ, r ^ 2 = algebraMap ℚ (QuarticCharacterField E) c := by
  have heval := Polynomial.aeval_eq_zero_of_mem_rootSet hr
  simp only [quarticCharacterPolynomial, map_mul, map_add, map_one,
    map_pow, map_prod, Polynomial.aeval_X, Polynomial.aeval_C,
    map_sub] at heval
  rcases mul_eq_zero.mp heval with hi | hd
  · exact ⟨-1, by simpa using (eq_neg_of_add_eq_zero_left hi)⟩
  · obtain ⟨d, hde, hdz⟩ := Finset.prod_eq_zero_iff.mp hd
    exact ⟨d, sub_eq_zero.mp hdz⟩

private instance (E : Finset ℕ) :
    IsMulCommutative Gal(QuarticCharacterField E/ℚ) :=
  galoisGroup_comm_of_quadratic_rootSet
    (QuarticCharacterField E) (quarticCharacterPolynomial E)
    (quarticCharacterPolynomial_root_sq E)

private instance (p : Polynomial ℚ) :
    Fact ((p.map (algebraMap ℚ ℂ)).Splits) :=
  ⟨IsAlgClosed.splits _⟩

/-- Complex conjugation restricts to every rational polynomial's splitting
field. -/
private noncomputable def quarticConjugation (p : Polynomial ℚ) :
    Gal(p.SplittingField/ℚ) :=
  (Complex.conjAe.restrictScalars ℚ).restrictNormal p.SplittingField

private theorem quarticConjugation_commutes (p : Polynomial ℚ)
    (x : p.SplittingField) :
    algebraMap p.SplittingField ℂ (quarticConjugation p x) =
      Complex.conjAe (algebraMap p.SplittingField ℂ x) :=
  AlgEquiv.restrictNormal_commutes
    (Complex.conjAe.restrictScalars ℚ) p.SplittingField x

private theorem complex_conj_fixed_of_sq_nonneg {z : ℂ} {c : ℚ}
    (hc : 0 ≤ c) (hz : z ^ 2 = (c : ℂ)) :
    Complex.conjAe z = z := by
  have hu : ((Real.sqrt (c : ℝ) : ℂ)) ^ 2 = (c : ℂ) := by
    norm_cast
    exact Real.sq_sqrt (by exact_mod_cast hc)
  rcases eq_or_eq_neg_of_sq_eq_sq z (Real.sqrt (c : ℝ) : ℂ)
      (hz.trans hu.symm) with h | h
  · simp [h, Complex.conjAe_coe]
  · simp [h, Complex.conjAe_coe]

private theorem complex_conj_flip_of_sq_neg_one {z : ℂ}
    (hz : z ^ 2 = -1) : Complex.conjAe z = -z := by
  rcases eq_or_eq_neg_of_sq_eq_sq z Complex.I
      (hz.trans Complex.I_sq.symm) with h | h
  · simp [h, Complex.conjAe_coe]
  · simp [h, Complex.conjAe_coe]

private theorem quarticConjugation_fix_sqrt
    (p : Polynomial ℚ) (x : p.SplittingField) (c : ℚ)
    (hc : 0 ≤ c) (hx : x ^ 2 = algebraMap ℚ p.SplittingField c) :
    quarticConjugation p x = x := by
  apply (algebraMap p.SplittingField ℂ).injective
  rw [quarticConjugation_commutes]
  apply complex_conj_fixed_of_sq_nonneg hc
  calc
    (algebraMap p.SplittingField ℂ x) ^ 2 =
        algebraMap p.SplittingField ℂ (x ^ 2) := (map_pow _ _ _).symm
    _ = algebraMap p.SplittingField ℂ (algebraMap ℚ p.SplittingField c) :=
      congrArg _ hx
    _ = (c : ℂ) := by simp

private theorem quarticConjugation_flip_i
    (p : Polynomial ℚ) (x : p.SplittingField)
    (hx : x ^ 2 = -1) : quarticConjugation p x = -x := by
  apply (algebraMap p.SplittingField ℂ).injective
  rw [quarticConjugation_commutes, map_neg]
  apply complex_conj_flip_of_sq_neg_one
  calc
    (algebraMap p.SplittingField ℂ x) ^ 2 =
        algebraMap p.SplittingField ℂ (x ^ 2) := (map_pow _ _ _).symm
    _ = -1 := by rw [hx, map_neg, map_one]

/-- Any existing real square-root sign pattern can be combined with
inversion of the fourth root of unity. -/
theorem quartic_correct_imaginary_sign
    (E : Finset ℕ) (i : QuarticCharacterField E)
    (hi : i ^ 2 = -1) (σ : Gal(QuarticCharacterField E/ℚ)) :
    ∃ φ : Gal(QuarticCharacterField E/ℚ), φ i = -i ∧
      ∀ x : QuarticCharacterField E, ∀ c : ℚ, 0 ≤ c →
        x ^ 2 = algebraMap ℚ (QuarticCharacterField E) c → φ x = σ x := by
  have hsq : (σ i) ^ 2 = i ^ 2 := by
    calc
      (σ i) ^ 2 = σ (i ^ 2) := (map_pow _ _ _).symm
      _ = -1 := by rw [hi, map_neg, map_one]
      _ = i ^ 2 := hi.symm
  have hfix (x : QuarticCharacterField E) (c : ℚ) (hc : 0 ≤ c)
      (hx : x ^ 2 = algebraMap ℚ (QuarticCharacterField E) c) :
      (quarticConjugation (quarticCharacterPolynomial E) * σ) x = σ x := by
    have hσsq : (σ x) ^ 2 = algebraMap ℚ (QuarticCharacterField E) c := by
      calc
        (σ x) ^ 2 = σ (x ^ 2) := (map_pow _ _ _).symm
        _ = algebraMap ℚ (QuarticCharacterField E) c := by
          rw [hx]
          exact σ.commutes c
    change quarticConjugation (quarticCharacterPolynomial E) (σ x) = σ x
    exact quarticConjugation_fix_sqrt (quarticCharacterPolynomial E)
      (σ x) c hc hσsq
  rcases eq_or_eq_neg_of_sq_eq_sq (σ i) i hsq with hsame | hneg
  · refine ⟨quarticConjugation (quarticCharacterPolynomial E) * σ,
      ?_, hfix⟩
    change quarticConjugation (quarticCharacterPolynomial E) (σ i) = -i
    rw [hsame]
    exact quarticConjugation_flip_i (quarticCharacterPolynomial E) i hi
  · exact ⟨σ, hneg, fun _ _ _ _ => rfl⟩

/-- The Frobenius classes that invert the chosen square root of `-1`.
They are precisely the classes relevant to primes `3 mod 4`. -/
abbrev OddQuarticAutomorphism (E : Finset ℕ)
    (i : QuarticCharacterField E) :=
  {σ : Gal(QuarticCharacterField E/ℚ) // σ i = -i}

theorem oddQuarticAutomorphism_nonempty
    (E : Finset ℕ) (i : QuarticCharacterField E)
    (hi : i ^ 2 = -1) :
    Nonempty (OddQuarticAutomorphism E i) := by
  obtain ⟨φ, hφ, _⟩ := quartic_correct_imaginary_sign E i hi 1
  exact ⟨⟨φ, hφ⟩⟩

/-- A square root of a rational nonsquare can be flipped by a Galois
automorphism in any normal field containing it. -/
theorem exists_flip_rational_square_root
    (L : Type*) [Field L] [Algebra ℚ L] [Normal ℚ L]
    (x : L) (d : ℚ) (hx : x ^ 2 = algebraMap ℚ L d)
    (hnsq : ∀ b : ℚ, b ^ 2 ≠ d) :
    ∃ σ : Gal(L/ℚ), σ x = -x := by
  have hp : Irreducible
      (Polynomial.X ^ 2 - Polynomial.C d : Polynomial ℚ) :=
    X_pow_sub_C_irreducible_of_prime (by decide) hnsq
  have heval : Polynomial.aeval x
      (Polynomial.X ^ 2 - Polynomial.C d : Polynomial ℚ) = 0 := by
    simp [hx]
  have hmin : minpoly ℚ x =
      (Polynomial.X ^ 2 - Polynomial.C d : Polynomial ℚ) :=
    (minpoly.eq_of_irreducible_of_monic hp heval
      (Polynomial.monic_X_pow_sub_C d (by decide))).symm
  have hneg : Polynomial.aeval (-x) (minpoly ℚ x) = 0 := by
    rw [hmin]
    simpa [hx] using heval
  exact minpoly.exists_algEquiv_of_root'
    (show IsAlgebraic ℚ x from ⟨_, hp.ne_zero, heval⟩) hneg

private theorem squarefree_ne_one_nonsquare_rat
    (m : ℕ) (hm : Squarefree m) (hm1 : m ≠ 1) :
    ∀ b : ℚ, b ^ 2 ≠ (m : ℚ) := by
  intro b hb
  have hsqQ : IsSquare (m : ℚ) :=
    ⟨b, by simpa [pow_two] using hb.symm⟩
  obtain ⟨a, ha⟩ := Rat.isSquare_natCast_iff.mp hsqQ
  have haunit : IsUnit a := hm a (by rw [ha])
  exact hm1 (by simpa [haunit.eq_one] using ha)

/-- Every positive nonsquare coefficient gives a nontrivial quadratic
Galois sign on the concrete quartic character field. -/
theorem quartic_exists_flip_squarefree_root
    (E : Finset ℕ) (m : ℕ) (hm : Squarefree m) (hm1 : m ≠ 1)
    (x : QuarticCharacterField E)
    (hx : x ^ 2 = (m : QuarticCharacterField E)) :
    ∃ σ : Gal(QuarticCharacterField E/ℚ), σ x = -x := by
  exact exists_flip_rational_square_root
    (QuarticCharacterField E) x (m : ℚ) (by simpa using hx)
    (squarefree_ne_one_nonsquare_rat m hm hm1)

/-- Every quadratic factor supplies an integral square root in the chosen
splitting field. -/
theorem exists_integral_square_root
    (E : Finset ℕ) (d : ℕ) (hd : d ∈ E) :
    ∃ a : 𝓞 (QuarticCharacterField E),
      a ^ 2 = (d : 𝓞 (QuarticCharacterField E)) := by
  let L := QuarticCharacterField E
  have hpoly : ((quarticCharacterPolynomial E).map (algebraMap ℚ L)).Splits :=
    Polynomial.SplittingField.splits (quarticCharacterPolynomial E)
  have hne : (quarticCharacterPolynomial E).map (algebraMap ℚ L) ≠ 0 :=
    ((quarticCharacterPolynomial_monic E).map (algebraMap ℚ L)).ne_zero
  have hdiv : (Polynomial.X ^ 2 - Polynomial.C (d : ℚ)) ∣
      quarticCharacterPolynomial E := by
    unfold quarticCharacterPolynomial
    exact dvd_mul_of_dvd_right
      (Finset.dvd_prod_of_mem
        (fun e : ℕ => (Polynomial.X : Polynomial ℚ) ^ 2 -
          Polynomial.C (e : ℚ)) hd) _
  have hsplit : ((Polynomial.X ^ 2 - Polynomial.C (d : ℚ)).map
      (algebraMap ℚ L)).Splits :=
    hpoly.of_dvd hne (Polynomial.map_dvd (algebraMap ℚ L) hdiv)
  have hdegree : Polynomial.degree
      ((Polynomial.X ^ 2 - Polynomial.C (d : ℚ)).map (algebraMap ℚ L)) ≠ 0 := by
    rw [Polynomial.degree_map, Polynomial.degree_X_pow_sub_C (by decide)]
    norm_num
  obtain ⟨x, hx⟩ := hsplit.exists_eval_eq_zero hdegree
  have hxpow : x ^ 2 = (d : L) :=
    sub_eq_zero.mp (by simpa using hx)
  have hxint : IsIntegral ℤ x :=
    IsIntegral.of_pow (n := 2) (by decide) (by
      rw [hxpow]
      simpa only [map_natCast] using
        (isIntegral_algebraMap (R := ℤ) (A := L) (x := (d : ℤ))))
  refine ⟨⟨x, hxint⟩, ?_⟩
  apply RingOfIntegers.coe_injective
  change x ^ 2 = (d : L)
  exact hxpow

/-- The same field contains an integral root of `X² + 1`. -/
theorem exists_integral_sqrt_neg_one (E : Finset ℕ) :
    ∃ z : 𝓞 (QuarticCharacterField E),
      z ^ 2 = -1 := by
  let L := QuarticCharacterField E
  have hpoly : ((quarticCharacterPolynomial E).map (algebraMap ℚ L)).Splits :=
    Polynomial.SplittingField.splits (quarticCharacterPolynomial E)
  have hne : (quarticCharacterPolynomial E).map (algebraMap ℚ L) ≠ 0 :=
    ((quarticCharacterPolynomial_monic E).map (algebraMap ℚ L)).ne_zero
  have hdiv : (Polynomial.X ^ 2 + 1 : Polynomial ℚ) ∣
      quarticCharacterPolynomial E := by
    unfold quarticCharacterPolynomial
    exact ⟨_, rfl⟩
  have hsplit : ((Polynomial.X ^ 2 + 1 : Polynomial ℚ).map
      (algebraMap ℚ L)).Splits :=
    hpoly.of_dvd hne (Polynomial.map_dvd (algebraMap ℚ L) hdiv)
  have hdegree : Polynomial.degree
      ((Polynomial.X ^ 2 + 1 : Polynomial ℚ).map (algebraMap ℚ L)) ≠ 0 := by
    rw [Polynomial.degree_map, ← Polynomial.C_1,
      Polynomial.degree_X_pow_add_C (by decide) (1 : ℚ)]
    norm_num
  obtain ⟨x, hx⟩ := hsplit.exists_eval_eq_zero hdegree
  have hxpow : x ^ 2 = (-1 : L) :=
    eq_neg_of_add_eq_zero_left (by simpa using hx)
  have hxint : IsIntegral ℤ x :=
    IsIntegral.of_pow (n := 2) (by decide) (by
      rw [hxpow]
      simpa only [map_neg, map_one] using
        (isIntegral_algebraMap (R := ℤ) (A := L) (x := (-1 : ℤ))))
  refine ⟨⟨x, hxint⟩, ?_⟩
  apply RingOfIntegers.coe_injective
  change x ^ 2 = (-1 : L)
  exact hxpow

/-- The root of `X² + 1` in the splitting field is a primitive fourth root
of unity. -/
theorem exists_primitive_fourth_root (E : Finset ℕ) :
    ∃ ζ : QuarticCharacterField E, IsPrimitiveRoot ζ 4 := by
  obtain ⟨z, hz⟩ := exists_integral_sqrt_neg_one E
  let ζ : QuarticCharacterField E := z
  have hζsq : ζ ^ 2 = -1 := by
    change ((z ^ 2 : 𝓞 (QuarticCharacterField E)) :
      QuarticCharacterField E) = -1
    rw [hz]
    simp
  have hζfour : ζ ^ 4 = 1 := by
    calc
      ζ ^ 4 = (ζ ^ 2) ^ 2 := by ring
      _ = 1 := by rw [hζsq]; norm_num
  have hζone : ζ ≠ 1 := by
    intro h
    rw [h] at hζsq
    norm_num at hζsq
  refine ⟨ζ, IsPrimitiveRoot.mk_of_lt ζ (by decide) hζfour ?_⟩
  intro l hl0 hl4 hl
  have hlcases : l = 1 ∨ l = 2 ∨ l = 3 := by omega
  rcases hlcases with rfl | rfl | rfl
  · exact hζone (by simpa using hl)
  · rw [hζsq] at hl
    norm_num at hl
  · have hζeq : ζ = 1 := by
      have h := hζfour
      rw [show ζ ^ 4 = ζ ^ 3 * ζ by ring, hl, one_mul] at h
      exact h
    exact hζone hζeq

/-- In any normal number field containing a primitive fourth root, an
automorphism acts on that root by inversion. In the quartic character field
this gives a nonempty `q ≡ 3 (mod 4)` Frobenius fiber. -/
theorem exists_inverting_fourth_root_aut
    (L : Type*) [Field L] [Algebra ℚ L] [Normal ℚ L]
    [FiniteDimensional ℚ L]
    {ζ : L} (hζ : IsPrimitiveRoot ζ 4) :
    ∃ σ : Gal(L/ℚ), σ ζ = -ζ := by
  letI : CharZero L := charZero_of_injective_algebraMap
    (algebraMap ℚ L).injective
  have hζsq : ζ ^ 2 = -1 := by
    have htwo : IsPrimitiveRoot (ζ ^ 2) 2 := by
      simpa using hζ.pow_of_dvd (p := 2) (by decide) (by decide)
    exact htwo.eq_neg_one_of_two_right
  have hζthree : IsPrimitiveRoot (ζ ^ 3) 4 :=
    hζ.pow_of_coprime 3 (by decide)
  haveI : NeZero (4 : ℚ) := ⟨by norm_num⟩
  haveI : NeZero (4 : L) := ⟨by norm_num⟩
  have hmin : minpoly ℚ ζ = Polynomial.cyclotomic 4 ℚ :=
    (hζ.minpoly_eq_cyclotomic_of_irreducible
      (Polynomial.cyclotomic.irreducible_rat (by decide))).symm
  have heval : Polynomial.aeval (ζ ^ 3) (minpoly ℚ ζ) = 0 := by
    rw [hmin]
    rwa [Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map,
      Polynomial.map_cyclotomic, ← Polynomial.IsRoot.def,
      Polynomial.isRoot_cyclotomic_iff]
  obtain ⟨σ, hσ⟩ := minpoly.exists_algEquiv_of_root'
    (IsAlgebraic.of_finite ℚ ζ) heval
  refine ⟨σ, ?_⟩
  simpa [pow_succ, hζsq] using hσ

/-- Reciprocal weight of an integer satisfying a prime-fiber predicate. -/
noncomputable def primeFiberWeight (P : ℕ → Prop) (q : ℕ) : ℝ :=
  if P q then 1 / (q : ℝ) else 0

private theorem primeFiberWeight_nonneg (P : ℕ → Prop) (q : ℕ) :
    0 ≤ primeFiberWeight P q := by
  unfold primeFiberWeight
  split_ifs <;> positivity

/- The rational-prime ideal dictionary follows the proof of the cubic
   prime-supply lemma. -/

private theorem quartic_absNorm_span_nat (q : ℕ) :
    Ideal.absNorm (Ideal.span {(q : 𝓞 ℚ)}) = q := by
  rw [Ideal.absNorm_span_natCast, NumberField.RingOfIntegers.rank,
    Module.finrank_self, pow_one]

private theorem quartic_ratSpan_eq_comap_intSpan (q : ℕ) :
    Ideal.span {(q : 𝓞 ℚ)} =
      Ideal.comap Rat.ringOfIntegersEquiv (Ideal.span {(q : ℤ)}) := by
  rw [← Ideal.map_symm Rat.ringOfIntegersEquiv, Ideal.map_span, Set.image_singleton]
  congr 2
  simp [map_natCast]

private theorem quartic_ratPrime_eq_span (𝔭 : Ideal (𝓞 ℚ))
    (hp : 𝔭.IsPrime) (hne : 𝔭 ≠ ⊥) :
    ∃ q : ℕ, q.Prime ∧ 𝔭 = Ideal.span {(q : 𝓞 ℚ)} := by
  set e := Rat.ringOfIntegersEquiv
  have hbij : Function.Bijective e := e.bijective
  have hJp : (Ideal.map e 𝔭).IsPrime := Ideal.map_isPrime_of_equiv e
  have hcomap : Ideal.comap e (Ideal.map e 𝔭) = 𝔭 :=
    Ideal.comap_map_of_bijective e hbij
  have hJne : Ideal.map e 𝔭 ≠ ⊥ := by
    intro h
    apply hne
    rw [← hcomap, h, Ideal.comap_bot_of_injective e hbij.injective]
  rcases Ideal.isPrime_int_iff.mp hJp with h | ⟨q, hq, hpJ⟩
  · exact absurd h hJne
  · exact ⟨q, hq, by rw [← hcomap, hpJ, quartic_ratSpan_eq_comap_intSpan]⟩

private theorem quartic_span_nat_isPrime {q : ℕ} (hq : q.Prime) :
    (Ideal.span {(q : 𝓞 ℚ)}).IsPrime := by
  haveI : (Ideal.span {(q : ℤ)}).IsPrime :=
    (Ideal.span_singleton_prime (by exact_mod_cast hq.ne_zero)).mpr
      (Nat.prime_iff_prime_int.mp hq)
  rw [quartic_ratSpan_eq_comap_intSpan]
  exact Ideal.comap_isPrime Rat.ringOfIntegersEquiv (Ideal.span {(q : ℤ)})

private theorem quartic_span_nat_ne_bot {q : ℕ} (hq : q.Prime) :
    Ideal.span {(q : 𝓞 ℚ)} ≠ ⊥ := by
  intro h
  have hnorm : Ideal.absNorm (Ideal.span {(q : 𝓞 ℚ)}) = 0 := by
    rw [Ideal.absNorm_eq_zero_iff]
    exact h
  rw [quartic_absNorm_span_nat] at hnorm
  exact hq.ne_zero hnorm

private noncomputable def quartic_rationalPrimeIdealEquiv
    (S : Set (Ideal (𝓞 ℚ))) :
    ↥({q : ℕ | q.Prime ∧ Ideal.span {(q : 𝓞 ℚ)} ∈ S} : Set ℕ) ≃
      {𝔭 : Ideal (𝓞 ℚ) // 𝔭 ∈ S ∧ 𝔭.IsPrime ∧ 𝔭 ≠ ⊥} := by
  classical
  let f : ↥({q : ℕ | q.Prime ∧ Ideal.span {(q : 𝓞 ℚ)} ∈ S} : Set ℕ) →
      {𝔭 : Ideal (𝓞 ℚ) // 𝔭 ∈ S ∧ 𝔭.IsPrime ∧ 𝔭 ≠ ⊥} :=
    fun q => ⟨Ideal.span {(q.1 : 𝓞 ℚ)}, q.2.2,
      quartic_span_nat_isPrime q.2.1, quartic_span_nat_ne_bot q.2.1⟩
  refine Equiv.ofBijective f ⟨?_, ?_⟩
  · intro q r heq
    apply Subtype.ext
    have hnorm := congrArg (fun 𝔭 : {𝔭 : Ideal (𝓞 ℚ) //
      𝔭 ∈ S ∧ 𝔭.IsPrime ∧ 𝔭 ≠ ⊥} => Ideal.absNorm 𝔭.1) heq
    change Ideal.absNorm (Ideal.span {(q.1 : 𝓞 ℚ)}) =
      Ideal.absNorm (Ideal.span {(r.1 : 𝓞 ℚ)}) at hnorm
    rw [quartic_absNorm_span_nat, quartic_absNorm_span_nat] at hnorm
    exact hnorm
  · intro 𝔭
    obtain ⟨q, hq, heq⟩ := quartic_ratPrime_eq_span 𝔭.1 𝔭.2.2.1 𝔭.2.2.2
    refine ⟨⟨q, hq, ?_⟩, ?_⟩
    · rw [← heq]
      exact 𝔭.2.1
    · apply Subtype.ext
      exact heq.symm

private theorem quartic_rationalPrimeIdealEquiv_norm
    (S : Set (Ideal (𝓞 ℚ)))
    (q : ↥({q : ℕ | q.Prime ∧ Ideal.span {(q : 𝓞 ℚ)} ∈ S} : Set ℕ)) :
    Ideal.absNorm ((quartic_rationalPrimeIdealEquiv S q).1) = q.1 := by
  change Ideal.absNorm (Ideal.span {(q.1 : 𝓞 ℚ)}) = q.1
  exact quartic_absNorm_span_nat q.1

private theorem quartic_rationalPrimeWeights_not_summable
    (S : Set (Ideal (𝓞 ℚ)))
    (hideal : ¬ Summable
      (fun 𝔭 : {𝔭 : Ideal (𝓞 ℚ) // 𝔭 ∈ S ∧ 𝔭.IsPrime ∧ 𝔭 ≠ ⊥} =>
        (1 : ℝ) / (Ideal.absNorm 𝔭.1 : ℝ))) :
    ¬ Summable (fun q : ℕ =>
      if q.Prime ∧ Ideal.span {(q : 𝓞 ℚ)} ∈ S then (1 : ℝ) / q else 0) := by
  intro hnat
  let e := quartic_rationalPrimeIdealEquiv S
  have hsub : Summable
      (fun q : ↥({q : ℕ | q.Prime ∧ Ideal.span {(q : 𝓞 ℚ)} ∈ S} : Set ℕ) =>
        (1 : ℝ) / q.1) := by
    have hindicator : Summable
        (Set.indicator {q : ℕ | q.Prime ∧ Ideal.span {(q : 𝓞 ℚ)} ∈ S}
          (fun q : ℕ => (1 : ℝ) / q)) := by
      convert hnat using 1
      funext q
      simp [Set.indicator_apply]
    simpa only [Set.mem_ofPred_eq, Function.comp_def] using
      (summable_subtype_iff_indicator.mpr hindicator)
  have hcomp : Summable
      (fun q : ↥({q : ℕ | q.Prime ∧ Ideal.span {(q : 𝓞 ℚ)} ∈ S} : Set ℕ) =>
        (1 : ℝ) / (Ideal.absNorm (e q).1 : ℝ)) := by
    simpa only [e, quartic_rationalPrimeIdealEquiv_norm] using hsub
  exact hideal (e.summable_iff.mp hcomp)

private theorem quartic_primeIdealReciprocals_not_summable_of_positive_density
    {K : Type*} [Field K] [NumberField K]
    {S : Set (Ideal (𝓞 K))} {δ : ℝ}
    (hS : Chebotarev.HasDirichletDensity S δ) (hδ : 0 < δ) :
    ¬ Summable (fun 𝔭 : {𝔭 : Ideal (𝓞 K) // 𝔭 ∈ S ∧ 𝔭.IsPrime ∧ 𝔭 ≠ ⊥} =>
      (1 : ℝ) / (Ideal.absNorm 𝔭.1 : ℝ)) := by
  intro hsum
  let C : ℝ := ∑' 𝔭 : {𝔭 : Ideal (𝓞 K) // 𝔭 ∈ S ∧ 𝔭.IsPrime ∧ 𝔭 ≠ ⊥},
    (1 : ℝ) / (Ideal.absNorm 𝔭.1 : ℝ)
  have hbound {s : ℝ} (hs : 1 < s) : Chebotarev.primeIdealZetaSum S s ≤ C := by
    rw [Chebotarev.primeIdealZetaSum_def]
    exact Summable.tsum_le_tsum (fun 𝔭 => by
      have hnorm : (1 : ℝ) ≤ (Ideal.absNorm 𝔭.1 : ℝ) := by
        exact_mod_cast Nat.one_le_iff_ne_zero.mpr (by
          rw [Ne, Ideal.absNorm_eq_zero_iff]
          exact 𝔭.2.2.2)
      simpa [Real.rpow_neg_one, one_div] using
        (Real.rpow_le_rpow_of_exponent_le hnorm (neg_le_neg hs.le)))
      (hsum.of_nonneg_of_le
        (fun 𝔭 => Real.rpow_nonneg (Nat.cast_nonneg _) _)
        (fun 𝔭 => by
          have hnorm : (1 : ℝ) ≤ (Ideal.absNorm 𝔭.1 : ℝ) := by
            exact_mod_cast Nat.one_le_iff_ne_zero.mpr (by
              rw [Ne, Ideal.absNorm_eq_zero_iff]
              exact 𝔭.2.2.2)
          simpa [Real.rpow_neg_one, one_div] using
            (Real.rpow_le_rpow_of_exponent_le hnorm (neg_le_neg hs.le))))
      hsum
  have hbd : ∀ᶠ s in 𝓝[>] (1 : ℝ), Chebotarev.primeIdealZetaSum S s ≤ C :=
    eventually_nhdsWithin_of_forall (fun _ hs => hbound hs)
  have hzero := Chebotarev.tendsto_primeIdealZetaSum_div_univ_zero_of_le_const K S C hbd
  exact hδ.ne' (tendsto_nhds_unique hS hzero)

/-- Chebotarev's theorem, transferred from prime ideals of `ℚ` to rational
primes: every Frobenius conjugacy class in a finite Galois number field has a
divergent reciprocal-prime sum. -/
theorem chebotarev_primeFiber_diverge
    (L : Type*) [Field L] [NumberField L] [Algebra ℚ L]
    [IsGalois ℚ L] [FiniteDimensional ℚ L]
    (C : ConjClasses Gal(L/ℚ)) :
    Tendsto (fun N : ℕ => ∑ q ∈ Finset.range N,
      primeFiberWeight (fun q => q.Prime ∧
        Chebotarev.UnramifiedIn ℚ L (Ideal.span {(q : 𝓞 ℚ)}) ∧
        Chebotarev.frobeniusClass ℚ L (Ideal.span {(q : 𝓞 ℚ)}) = C) q)
      atTop atTop := by
  let S : Set (Ideal (𝓞 ℚ)) :=
    {𝔭 | 𝔭.IsPrime ∧ Chebotarev.UnramifiedIn ℚ L 𝔭 ∧
      Chebotarev.frobeniusClass ℚ L 𝔭 = C}
  have hS : Chebotarev.HasDirichletDensity S
      ((Nat.card C.carrier : ℝ) / Nat.card Gal(L/ℚ)) :=
    Chebotarev.chebotarev_density C
  have hpos : 0 < ((Nat.card C.carrier : ℝ) / Nat.card Gal(L/ℚ)) := by
    apply div_pos
    · exact_mod_cast Chebotarev.ConjClasses_carrier_card_pos C
    · exact_mod_cast Nat.card_pos (α := Gal(L/ℚ))
  have hideal :=
    quartic_primeIdealReciprocals_not_summable_of_positive_density hS hpos
  have hrat := quartic_rationalPrimeWeights_not_summable S hideal
  have hnonsum : ¬ Summable (primeFiberWeight (fun q => q.Prime ∧
        Chebotarev.UnramifiedIn ℚ L (Ideal.span {(q : 𝓞 ℚ)}) ∧
        Chebotarev.frobeniusClass ℚ L (Ideal.span {(q : 𝓞 ℚ)}) = C)) := by
    intro h
    apply hrat
    convert h using 1
    funext q
    by_cases hq : q.Prime
    · simp [primeFiberWeight, S, hq, quartic_span_nat_isPrime hq]
    · simp [primeFiberWeight, S, hq]
  have hnonneg : ∀ q, 0 ≤ primeFiberWeight (fun q => q.Prime ∧
        Chebotarev.UnramifiedIn ℚ L (Ideal.span {(q : 𝓞 ℚ)}) ∧
        Chebotarev.frobeniusClass ℚ L (Ideal.span {(q : 𝓞 ℚ)}) = C) q := by
    intro q
    unfold primeFiberWeight
    split_ifs <;> positivity
  exact (not_summable_iff_tendsto_nat_atTop_of_nonneg hnonneg).mp hnonsum

/-- Stop a divergent reciprocal-prime sum when it first crosses a prescribed
target. The overshoot is at most the largest permitted reciprocal. -/
theorem finite_primeFiber_batch (P : ℕ → Prop) (T ε : ℝ)
    (hT : 0 ≤ T) (hε : 0 ≤ ε)
    (hdiv : Tendsto (fun N : ℕ =>
      ∑ q ∈ Finset.range N, primeFiberWeight P q) atTop atTop)
    (hsmall : ∀ q, P q → (1 : ℝ) / q ≤ ε) :
    ∃ Q : Finset ℕ,
      (∀ q ∈ Q, P q) ∧
      T ≤ ∑ q ∈ Q, (1 : ℝ) / q ∧
      (∑ q ∈ Q, (1 : ℝ) / q) ≤ T + ε := by
  classical
  rcases eq_or_lt_of_le hT with hzero | hpositive
  · subst T
    exact ⟨∅, by simp, by simp, by simp [hε]⟩
  let S (N : ℕ) : ℝ := ∑ q ∈ Finset.range N, primeFiberWeight P q
  have hexists : ∃ N : ℕ, T ≤ S N :=
    (hdiv.eventually_ge_atTop T).exists
  have hnonzero : Nat.find hexists ≠ 0 := by
    intro heq
    have hT0 : T ≤ 0 := by
      simpa [heq, S] using (Nat.find_spec hexists)
    exact (not_le_of_gt hpositive) hT0
  obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hnonzero
  have hprevious : S n < T := by
    have hnlt : n < Nat.find hexists := by
      rw [hn]
      exact Nat.lt_succ_self n
    exact lt_of_not_ge (Nat.find_min hexists hnlt)
  have hcurrent : T ≤ S (n + 1) := by
    simpa [hn] using (Nat.find_spec hexists)
  have hstep : S (n + 1) = S n + primeFiberWeight P n := by
    simp [S, Finset.sum_range_succ]
  have hweight : primeFiberWeight P n ≤ ε := by
    unfold primeFiberWeight
    split_ifs with hp
    · exact hsmall n hp
    · exact hε
  have hcurrentUpper : S (n + 1) ≤ T + ε := by
    calc
      S (n + 1) = S n + primeFiberWeight P n := hstep
      _ ≤ T + ε := add_le_add hprevious.le hweight
  let Q := (Finset.range (n + 1)).filter P
  have hQ : ∀ q ∈ Q, P q := by
    intro q hq
    exact (Finset.mem_filter.mp hq).2
  have hQsum : (∑ q ∈ Q, (1 : ℝ) / q) = S (n + 1) := by
    simp [Q, S, primeFiberWeight, Finset.sum_filter]
  exact ⟨Q, hQ, by simpa only [hQsum] using hcurrent,
    by simpa only [hQsum] using hcurrentUpper⟩

/-- Removing all integers up to a fixed cutoff preserves divergence of a
nonnegative reciprocal-prime sum. -/
theorem primeFiberWeight_diverge_above_cutoff
    (P : ℕ → Prop) (B : ℕ)
    (hdiv : Tendsto (fun N : ℕ =>
      ∑ q ∈ Finset.range N, primeFiberWeight P q) atTop atTop) :
    Tendsto (fun N : ℕ => ∑ q ∈ Finset.range N,
      primeFiberWeight (fun q => P q ∧ B < q) q) atTop atTop := by
  have hnonsum : ¬ Summable (primeFiberWeight P) :=
    (not_summable_iff_tendsto_nat_atTop_of_nonneg
      (primeFiberWeight_nonneg P)).mpr hdiv
  have hbad : Summable (fun q : ℕ =>
      if q ≤ B then primeFiberWeight P q else 0) := by
    apply summable_of_hasFiniteSupport
    apply (Set.finite_Iic B).subset
    intro q hq
    by_contra hle
    exact hq (by simp [show ¬ q ≤ B from hle])
  have hpoint (q : ℕ) :
      primeFiberWeight P q =
        primeFiberWeight (fun n => P n ∧ B < n) q +
          (if q ≤ B then primeFiberWeight P q else 0) := by
    by_cases hp : P q
    · by_cases hq : B < q
      · simp [primeFiberWeight, hp, hq, Nat.not_le.mpr hq]
      · simp [primeFiberWeight, hp, hq, Nat.le_of_not_gt hq]
    · simp [primeFiberWeight, hp]
  have hrestricted : ¬ Summable (primeFiberWeight (fun q => P q ∧ B < q)) := by
    intro hs
    apply hnonsum
    convert hs.add hbad using 1
    funext q
    exact hpoint q
  exact (not_summable_iff_tendsto_nat_atTop_of_nonneg
    (primeFiberWeight_nonneg _)).mp hrestricted

/-- Chebotarev reciprocal divergence after excluding any finite interval. -/
theorem chebotarev_primeFiber_diverge_above
    (L : Type*) [Field L] [NumberField L] [Algebra ℚ L]
    [IsGalois ℚ L] [FiniteDimensional ℚ L]
    (C : ConjClasses Gal(L/ℚ)) (B : ℕ) :
    Tendsto (fun N : ℕ => ∑ q ∈ Finset.range N,
      primeFiberWeight (fun q => q.Prime ∧
        Chebotarev.UnramifiedIn ℚ L (Ideal.span {(q : 𝓞 ℚ)}) ∧
        Chebotarev.frobeniusClass ℚ L (Ideal.span {(q : 𝓞 ℚ)}) = C ∧
        B < q) q) atTop atTop := by
  simpa only [and_assoc] using
    (primeFiberWeight_diverge_above_cutoff _ B
      (chebotarev_primeFiber_diverge L C))

/-- Every imaginary-inverting automorphism in the concrete character field
has an inexhaustible reciprocal-prime Frobenius fiber beyond any cutoff. -/
theorem oddQuartic_primeFiber_diverge_above
    (E : Finset ℕ) (i : QuarticCharacterField E)
    (g : OddQuarticAutomorphism E i) (B : ℕ) :
    Tendsto (fun N : ℕ => ∑ q ∈ Finset.range N,
      primeFiberWeight (fun q => q.Prime ∧
        Chebotarev.UnramifiedIn ℚ (QuarticCharacterField E)
          (Ideal.span {(q : 𝓞 ℚ)}) ∧
        Chebotarev.frobeniusClass ℚ (QuarticCharacterField E)
          (Ideal.span {(q : 𝓞 ℚ)}) = ConjClasses.mk g.val ∧
        B < q) q) atTop atTop :=
  chebotarev_primeFiber_diverge_above
    (QuarticCharacterField E) (ConjClasses.mk g.val) B

private theorem quartic_conjClass_mk_injective
    (E : Finset ℕ) {σ τ : Gal(QuarticCharacterField E/ℚ)}
    (h : ConjClasses.mk σ = ConjClasses.mk τ) : σ = τ := by
  letI : CommMonoid Gal(QuarticCharacterField E/ℚ) :=
    IsMulCommutative.instCommMonoid
  exact isConj_iff_eq.mp (ConjClasses.mk_eq_mk_iff_isConj.mp h)

/-- A total class selector, with an arbitrary fallback away from the odd
Frobenius fibers. On each relevant fiber it returns the unique automorphism
representing that class. -/
noncomputable def oddQuarticClassOf
    (E : Finset ℕ) (i : QuarticCharacterField E)
    (hi : i ^ 2 = -1) (q : ℕ) : OddQuarticAutomorphism E i := by
  classical
  letI : Nonempty (OddQuarticAutomorphism E i) :=
    oddQuarticAutomorphism_nonempty E i hi
  exact if h : ∃ g : OddQuarticAutomorphism E i,
      Chebotarev.frobeniusClass ℚ (QuarticCharacterField E)
        (Ideal.span {(q : 𝓞 ℚ)}) = ConjClasses.mk g.val then
    Classical.choose h
  else Classical.choice inferInstance

theorem oddQuarticClassOf_eq
    (E : Finset ℕ) (i : QuarticCharacterField E)
    (hi : i ^ 2 = -1) (q : ℕ)
    (g : OddQuarticAutomorphism E i)
    (h : Chebotarev.frobeniusClass ℚ (QuarticCharacterField E)
      (Ideal.span {(q : 𝓞 ℚ)}) = ConjClasses.mk g.val) :
    oddQuarticClassOf E i hi q = g := by
  classical
  unfold oddQuarticClassOf
  rw [dif_pos ⟨g, h⟩]
  apply Subtype.ext
  apply quartic_conjClass_mk_injective E
  exact (Classical.choose_spec (show ∃ t : OddQuarticAutomorphism E i,
      Chebotarev.frobeniusClass ℚ (QuarticCharacterField E)
        (Ideal.span {(q : 𝓞 ℚ)}) = ConjClasses.mk t.val from ⟨g, h⟩)).symm.trans h

/-- Simultaneous finite selection from disjoint Frobenius fibers. The hypotheses
`hdiv` and `hclass` are the precise Chebotarev and arithmetic inputs; all
finite-budget conclusions follow without further analytic arguments.

The weights have average one (`∑ w = 1`) and each tested character has the
specified negative moment. For the quartic proof one takes `ε = 1 / |G|`.
The output works for every member of the finite character family at once. -/
theorem select_prime_fibers
    {G I : Type*} [Fintype G] [Nonempty G] [Fintype I]
    (P : G → ℕ → Prop) (classOf : ℕ → G)
    (hclass : ∀ g q, P g q → classOf q = g)
    (hdiv : ∀ g, Tendsto (fun N : ℕ =>
      ∑ q ∈ Finset.range N, primeFiberWeight (P g) q) atTop atTop)
    (ε : ℝ) (hε : 0 ≤ ε)
    (hsmall : ∀ g q, P g q → (1 : ℝ) / q ≤ ε)
    (hbudget : (Fintype.card G : ℝ) * ε ≤ 1)
    (w : G → ℝ) (hw : ∀ g, 0 ≤ w g)
    (hwsum : ∑ g, w g = 1)
    (χ : I → G → ℝ) (c : I → ℝ)
    (hχ : ∀ i g, |χ i g| ≤ 1)
    (hmoment : ∀ i, ∑ g, w g * χ i g = -c i)
    (T : ℝ) (hT : 0 ≤ T) :
    ∃ Q : Finset ℕ,
      (∀ q ∈ Q, ∃ g, P g q) ∧
      (∑ q ∈ Q, (1 : ℝ) / q) ≤ T + 1 ∧
      (∀ i, (∑ q ∈ Q, χ i (classOf q) * ((1 : ℝ) / q)) ≤ -T * c i + 1) := by
  classical
  have hbatch (g : G) : ∃ Q : Finset ℕ,
      (∀ q ∈ Q, P g q) ∧
      T * w g ≤ ∑ q ∈ Q, (1 : ℝ) / q ∧
      (∑ q ∈ Q, (1 : ℝ) / q) ≤ T * w g + ε :=
    finite_primeFiber_batch (P g) (T * w g) ε
      (mul_nonneg hT (hw g)) hε (hdiv g) (hsmall g)
  let Qg (g : G) : Finset ℕ := (hbatch g).choose
  have hQg (g : G) : ∀ q ∈ Qg g, P g q := (hbatch g).choose_spec.1
  have hlow (g : G) : T * w g ≤ ∑ q ∈ Qg g, (1 : ℝ) / q :=
    (hbatch g).choose_spec.2.1
  have hupp (g : G) : (∑ q ∈ Qg g, (1 : ℝ) / q) ≤ T * w g + ε :=
    (hbatch g).choose_spec.2.2
  have hdisj : ∀ g ∈ (Finset.univ : Finset G), ∀ g' ∈ (Finset.univ : Finset G),
      g ≠ g' → Disjoint (Qg g) (Qg g') := by
    intro g _ g' _ hne
    apply Finset.disjoint_left.mpr
    intro q hq hq'
    exact hne ((hclass g q (hQg g q hq)).symm.trans
      (hclass g' q (hQg g' q hq')))
  let Q : Finset ℕ := Finset.univ.biUnion Qg
  have hsum (a : ℕ → ℝ) :
      ∑ q ∈ Q, a q = ∑ g : G, ∑ q ∈ Qg g, a q := by
    exact Finset.sum_biUnion hdisj
  have hQ : ∀ q ∈ Q, ∃ g, P g q := by
    intro q hq
    obtain ⟨g, _, hqg⟩ := Finset.mem_biUnion.mp hq
    exact ⟨g, hQg g q hqg⟩
  have htotal : (∑ q ∈ Q, (1 : ℝ) / q) ≤ T + 1 := by
    rw [hsum (fun q => (1 : ℝ) / q)]
    calc
      (∑ g : G, ∑ q ∈ Qg g, (1 : ℝ) / q) ≤
          ∑ g : G, (T * w g + ε) := Finset.sum_le_sum (fun g _ => hupp g)
      _ = T * (∑ g : G, w g) + (Fintype.card G : ℝ) * ε := by
        simp [Finset.sum_add_distrib, ← Finset.mul_sum]
      _ ≤ T + 1 := by simpa [hwsum] using add_le_add_left hbudget T
  refine ⟨Q, hQ, htotal, ?_⟩
  intro i
  have hchar (g : G) :
      (∑ q ∈ Qg g, χ i (classOf q) * ((1 : ℝ) / q)) =
        χ i g * (∑ q ∈ Qg g, (1 : ℝ) / q) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro q hq
    rw [hclass g q (hQg g q hq)]
  have hterm (g : G) :
      χ i g * (∑ q ∈ Qg g, (1 : ℝ) / q) ≤
        T * w g * χ i g + ε := by
    have hδlo : 0 ≤ (∑ q ∈ Qg g, (1 : ℝ) / q) - T * w g := sub_nonneg.mpr (hlow g)
    have hδhi : (∑ q ∈ Qg g, (1 : ℝ) / q) - T * w g ≤ ε := by
      linarith [hupp g]
    have hχhi : χ i g ≤ 1 := (abs_le.mp (hχ i g)).2
    nlinarith [mul_nonneg hδlo (sub_nonneg.mpr hχhi)]
  rw [hsum (fun q => χ i (classOf q) * ((1 : ℝ) / q))]
  simp_rw [hchar]
  calc
    (∑ g : G, χ i g * (∑ q ∈ Qg g, (1 : ℝ) / q)) ≤
        ∑ g : G, (T * w g * χ i g + ε) :=
      Finset.sum_le_sum (fun g _ => by nlinarith [hterm g])
    _ = T * (∑ g : G, w g * χ i g) + (Fintype.card G : ℝ) * ε := by
      simp [Finset.sum_add_distrib, ← Finset.mul_sum, mul_assoc]
    _ ≤ -T * c i + 1 := by
      rw [hmoment i]
      nlinarith [hbudget]

/-- The weighted character distribution from equations (17)–(18). This is
stated for any finite orthogonal family of real-valued characters; the
arithmetic interpretation of each character is supplied separately. -/
theorem character_distribution_weights
    {G I : Type*} [Fintype G] [Nonempty G] [Fintype I]
    (χ : I → G → ℝ) (c : I → ℝ)
    (hc : ∀ i, 0 ≤ c i) (hctotal : (∑ i, c i) ≤ (1 / 2 : ℝ))
    (hχ : ∀ i g, |χ i g| ≤ 1)
    (hzero : ∀ i, ∑ g, χ i g = 0)
    (horth : ∀ j i, ∑ g, χ j g * χ i g =
      if j = i then (Fintype.card G : ℝ) else 0) :
    ∃ w : G → ℝ,
      (∀ g, 0 ≤ w g) ∧
      (∑ g, w g) = 1 ∧
      (∀ i, ∑ g, w g * χ i g = -c i) := by
  classical
  let n : ℝ := Fintype.card G
  have hnpos : 0 < n := by
    dsimp [n]
    exact_mod_cast (Fintype.card_pos : 0 < Fintype.card G)
  have hn : n ≠ 0 := ne_of_gt hnpos
  let w (g : G) : ℝ := (1 - ∑ i, c i * χ i g) / n
  have hw (g : G) : 0 ≤ w g := by
    have hsumle : (∑ i, c i * χ i g) ≤ ∑ i, c i := by
      apply Finset.sum_le_sum
      intro i _
      have hχhi : χ i g ≤ 1 := (abs_le.mp (hχ i g)).2
      nlinarith [mul_nonneg (hc i) (sub_nonneg.mpr hχhi)]
    dsimp [w]
    apply div_nonneg _ hnpos.le
    linarith
  have hrawsum : (∑ g : G, (1 - ∑ i, c i * χ i g)) = n := by
    calc
      (∑ g : G, (1 - ∑ i, c i * χ i g)) =
          (∑ g : G, (1 : ℝ)) - ∑ i, c i * (∑ g : G, χ i g) := by
        rw [Finset.sum_sub_distrib, Finset.sum_comm]
        simp_rw [← Finset.mul_sum]
      _ = n := by simp [hzero, n]
  have hwsum : (∑ g : G, w g) = 1 := by
    dsimp [w]
    rw [← Finset.sum_div, hrawsum]
    exact div_self hn
  have hrawmoment (i : I) :
      (∑ g : G, (1 - ∑ j, c j * χ j g) * χ i g) = -(n * c i) := by
    calc
      (∑ g : G, (1 - ∑ j, c j * χ j g) * χ i g) =
          (∑ g : G, χ i g) -
            ∑ j, c j * (∑ g : G, χ j g * χ i g) := by
        simp_rw [sub_mul, one_mul, Finset.sum_sub_distrib, Finset.sum_mul]
        rw [Finset.sum_comm]
        simp_rw [mul_assoc, ← Finset.mul_sum]
      _ = -(n * c i) := by
        simp [hzero, horth, n, mul_comm]
  refine ⟨w, hw, hwsum, ?_⟩
  intro i
  calc
    (∑ g : G, w g * χ i g) =
        (∑ g : G, (1 - ∑ j, c j * χ j g) * χ i g) / n := by
      simp_rw [w, div_mul_eq_mul_div]
      rw [Finset.sum_div]
    _ = -c i := by
      rw [hrawmoment]
      field_simp

/-- The finite-group orthogonality input: a nontrivial real-valued
multiplicative character sums to zero. -/
theorem finite_group_character_sum_zero
    {G : Type*} [Group G] [Fintype G]
    (χ : G →* ℝ) (hχ : ∃ g, χ g ≠ 1) :
    ∑ g, χ g = 0 := by
  obtain ⟨a, ha⟩ := hχ
  apply eq_zero_of_mul_eq_self_left ha
  rw [Finset.mul_sum]
  exact Fintype.sum_equiv (Equiv.mulLeft a) _ _
    (fun g => (map_mul χ a g).symm)

/-- The sign by which a Galois automorphism acts on a nonzero square root
is a real multiplicative character. -/
noncomputable def squareRootGaloisCharacter
    (L : Type*) [Field L] [Algebra ℚ L]
    (x : L) (c : ℚ) (hx : x ^ 2 = algebraMap ℚ L c)
    (hx0 : x ≠ 0) : Gal(L/ℚ) →* ℝ := by
  classical
  letI : CharZero L := charZero_of_injective_algebraMap
    (algebraMap ℚ L).injective
  have hneg : -x ≠ x := by
    simpa only [ne_eq, CharZero.neg_eq_self_iff] using hx0
  have hsign (σ : Gal(L/ℚ)) : σ x = x ∨ σ x = -x := by
    apply eq_or_eq_neg_of_sq_eq_sq
    calc
      (σ x) ^ 2 = σ (x ^ 2) := (map_pow _ _ _).symm
      _ = algebraMap ℚ L c := by rw [hx]; exact σ.commutes c
      _ = x ^ 2 := hx.symm
  refine {
    toFun := fun σ => if σ x = x then 1 else -1
    map_one' := by simp
    map_mul' := ?_
  }
  intro σ τ
  rcases hsign σ with hσ | hσ <;>
    rcases hsign τ with hτ | hτ <;>
    simp [hσ, hτ, hneg, map_neg]

theorem squareRootGaloisCharacter_sign
    (L : Type*) [Field L] [Algebra ℚ L]
    (x : L) (c : ℚ) (hx : x ^ 2 = algebraMap ℚ L c)
    (hx0 : x ≠ 0) (σ : Gal(L/ℚ)) :
    squareRootGaloisCharacter L x c hx hx0 σ = 1 ∨
    squareRootGaloisCharacter L x c hx hx0 σ = -1 := by
  change (if σ x = x then (1 : ℝ) else -1) = 1 ∨
    (if σ x = x then (1 : ℝ) else -1) = -1
  split_ifs <;> simp

theorem squareRootGaloisCharacter_eq_neg_one_iff
    (L : Type*) [Field L] [Algebra ℚ L]
    (x : L) (c : ℚ) (hx : x ^ 2 = algebraMap ℚ L c)
    (hx0 : x ≠ 0) (σ : Gal(L/ℚ)) :
    squareRootGaloisCharacter L x c hx hx0 σ = -1 ↔
      σ x = -x := by
  letI : CharZero L := charZero_of_injective_algebraMap
    (algebraMap ℚ L).injective
  have hneg : -x ≠ x := by
    simpa only [ne_eq, CharZero.neg_eq_self_iff] using hx0
  have hsq : (σ x) ^ 2 = x ^ 2 := by
    calc
      (σ x) ^ 2 = σ (x ^ 2) := (map_pow _ _ _).symm
      _ = algebraMap ℚ L c := by rw [hx]; exact σ.commutes c
      _ = x ^ 2 := hx.symm
  change (if σ x = x then (1 : ℝ) else -1) = -1 ↔ σ x = -x
  constructor
  · intro h
    have hnot : σ x ≠ x := by
      intro heq
      simp [heq] at h
      norm_num at h
    exact (eq_or_eq_neg_of_sq_eq_sq _ _ hsq).resolve_left hnot
  · intro h
    simp [h, hneg]

/-- The imaginary quadratic character attached to the chosen square root
of `-1` in the concrete quartic field. -/
noncomputable def imaginaryGaloisCharacter
    (E : Finset ℕ) (i : QuarticCharacterField E)
    (hi : i ^ 2 = -1) :
    Gal(QuarticCharacterField E/ℚ) →* ℝ :=
  squareRootGaloisCharacter (QuarticCharacterField E) i (-1)
    (by simpa using hi)
    (by
      intro h
      rw [h] at hi
      norm_num at hi)

/-- The action-based odd coset is exactly the negative fiber of the
imaginary quadratic character. -/
noncomputable def oddQuarticEquivSignFiber
    (E : Finset ℕ) (i : QuarticCharacterField E)
    (hi : i ^ 2 = -1) :
    OddQuarticAutomorphism E i ≃
      {σ : Gal(QuarticCharacterField E/ℚ) //
        imaginaryGaloisCharacter E i hi σ = -1} := by
  let hi0 : i ≠ 0 := by
    intro h
    rw [h] at hi
    norm_num at hi
  let hs : i ^ 2 = algebraMap ℚ (QuarticCharacterField E) (-1) := by
    simpa using hi
  have heq (σ : Gal(QuarticCharacterField E/ℚ)) :
      imaginaryGaloisCharacter E i hi σ = -1 ↔ σ i = -i := by
    simpa only [imaginaryGaloisCharacter] using
      squareRootGaloisCharacter_eq_neg_one_iff
        (QuarticCharacterField E) i (-1) hs hi0 σ
  refine {
    toFun := fun g => ⟨g.val, (heq g.val).2 g.property⟩
    invFun := fun g => ⟨g.val, (heq g.val).1 g.property⟩
    left_inv := fun g => by apply Subtype.ext; rfl
    right_inv := fun g => by apply Subtype.ext; rfl
  }

/-- A rational nonsquare gives a nontrivial quadratic character. -/
theorem squareRootGaloisCharacter_nontrivial
    (L : Type*) [Field L] [Algebra ℚ L] [Normal ℚ L]
    (x : L) (c : ℚ) (hx : x ^ 2 = algebraMap ℚ L c)
    (hx0 : x ≠ 0) (hnsq : ∀ b : ℚ, b ^ 2 ≠ c) :
    squareRootGaloisCharacter L x c hx hx0 ≠ 1 := by
  obtain ⟨σ, hσ⟩ := exists_flip_rational_square_root L x c hx hnsq
  intro htriv
  have hval := congrArg (fun ψ : Gal(L/ℚ) →* ℝ => ψ σ) htriv
  have hne : σ x ≠ x := by
    rw [hσ]
    letI : CharZero L := charZero_of_injective_algebraMap
      (algebraMap ℚ L).injective
    simpa only [ne_eq, CharZero.neg_eq_self_iff] using hx0
  change (if σ x = x then (1 : ℝ) else -1) = 1 at hval
  simp [hne] at hval
  norm_num at hval

/-- Distinct nontrivial quadratic characters are orthogonal on their
finite Galois group. -/
theorem finite_quadratic_character_orthogonality
    {G I : Type*} [Group G] [Fintype G] [Fintype I]
    (χ : I → G →* ℝ) (hχ : ∀ i g, χ i g = 1 ∨ χ i g = -1)
    (hinj : Function.Injective χ) (hnon : ∀ i, χ i ≠ 1) :
    (∀ i, ∑ g, χ i g = 0) ∧
      (∀ j i, ∑ g, χ j g * χ i g =
        if j = i then (Fintype.card G : ℝ) else 0) := by
  have hsq (i : I) : χ i * χ i = 1 := by
    ext g
    rcases hχ i g with hi | hi <;> simp [hi]
  have hnonpoint (ψ : G →* ℝ) (hψ : ψ ≠ 1) :
      ∃ g, ψ g ≠ 1 := by
    by_contra hall
    apply hψ
    ext g
    have hg := not_exists.mp hall g
    simpa using not_not.mp hg
  constructor
  · intro i
    exact finite_group_character_sum_zero (χ i)
      (hnonpoint (χ i) (hnon i))
  · intro j i
    by_cases hji : j = i
    · subst j
      simp only [if_pos rfl]
      calc
        (∑ g, χ i g * χ i g) = ∑ _g : G, (1 : ℝ) := by
          apply Finset.sum_congr rfl
          intro g _
          rcases hχ i g with hi | hi <;> simp [hi]
        _ = (Fintype.card G : ℝ) := by simp
    · have hprod : χ j * χ i ≠ 1 := by
        intro h
        apply hji (hinj ?_)
        calc
          χ j = χ j * 1 := by simp
          _ = χ j * (χ i * χ i) := by rw [hsq]
          _ = (χ j * χ i) * χ i := by ac_rfl
          _ = χ i := by rw [h]; simp
      simp only [if_neg hji]
      simpa using finite_group_character_sum_zero (χ j * χ i)
        (hnonpoint (χ j * χ i) hprod)

private theorem odd_coset_sum_zero_of_kernel_witness
    {G : Type*} [Group G] [Fintype G]
    (ν χ : G →* ℝ) (h : G) (hν : ν h = 1) (hχ : χ h = -1) :
    (∑ g : {g : G // ν g = -1}, χ g.1) = 0 := by
  classical
  let f : G → ℝ := fun g => if ν g = -1 then χ g else 0
  have hsum : (∑ g : G, f g) = ∑ g : G, f (h * g) :=
    (Equiv.sum_comp (Equiv.mulLeft h) f).symm
  have hterm (g : G) : f (h * g) = -f g := by
    simp [f, map_mul, hν, hχ, neg_ite]
  have hzero : (∑ g : G, f g) = 0 := by
    have hneg : (∑ g : G, f g) = -(∑ g : G, f g) := by
      calc
        (∑ g : G, f g) = ∑ g : G, f (h * g) := hsum
        _ = ∑ g : G, -f g := by
          exact Finset.sum_congr rfl (fun g _ => hterm g)
        _ = -(∑ g : G, f g) := by rw [Finset.sum_neg_distrib]
    linarith
  calc
    (∑ g : {g : G // ν g = -1}, χ g.1) =
        ∑ g ∈ (Finset.univ : Finset G) with ν g = -1, χ g := by
          rw [← Finset.sum_subtype_eq_sum_filter]
          simp
    _ = 0 := by simpa [f, Finset.sum_ite] using hzero

private theorem odd_coset_exists_kernel_witness
    {G : Type*} [Group G] [Fintype G]
    (ν χ : G →* ℝ) (τ : G)
    (hνsign : ∀ g, ν g = 1 ∨ ν g = -1)
    (hντ : ν τ = -1) (hχτ : χ τ = 1)
    (hχnontriv : ∃ g, χ g = -1) :
    ∃ h, ν h = 1 ∧ χ h = -1 := by
  obtain ⟨g, hg⟩ := hχnontriv
  rcases hνsign g with hνg | hνg
  · exact ⟨g, hνg, hg⟩
  · refine ⟨τ * g, ?_, ?_⟩
    · rw [map_mul, hντ, hνg]
      norm_num
    · rw [map_mul, hχτ, hg]
      norm_num

/-- Orthogonality of a nontrivial real sign character on the odd coset,
provided a distinguished involution reverses the imaginary sign but fixes
the tested character. The involution need not have order two for the proof. -/
theorem odd_coset_character_sum_zero
    {G : Type*} [Group G] [Fintype G]
    (ν χ : G →* ℝ) (τ : G)
    (hνsign : ∀ g, ν g = 1 ∨ ν g = -1)
    (hντ : ν τ = -1) (hχτ : χ τ = 1)
    (hχnontriv : ∃ g, χ g = -1) :
    (∑ g : {g : G // ν g = -1}, χ g.1) = 0 := by
  obtain ⟨h, hν, hχ⟩ :=
    odd_coset_exists_kernel_witness ν χ τ hνsign hντ hχτ hχnontriv
  exact odd_coset_sum_zero_of_kernel_witness ν χ h hν hχ

/-- Products of distinct real sign characters also have zero mean on the
odd coset. -/
theorem odd_coset_character_product_sum_zero
    {G : Type*} [Group G] [Fintype G]
    (ν χ ψ : G →* ℝ) (τ : G)
    (hνsign : ∀ g, ν g = 1 ∨ ν g = -1)
    (hχsign : ∀ g, χ g = 1 ∨ χ g = -1)
    (hψsign : ∀ g, ψ g = 1 ∨ ψ g = -1)
    (hντ : ν τ = -1) (hχτ : χ τ = 1) (hψτ : ψ τ = 1)
    (hne : χ ≠ ψ) :
    (∑ g : {g : G // ν g = -1}, χ g.1 * ψ g.1) = 0 := by
  have hprod : ∃ g, χ g * ψ g = -1 := by
    by_contra! hn
    apply hne
    ext g
    rcases hχsign g with hc | hc <;> rcases hψsign g with hp | hp
    · rw [hc, hp]
    · exact False.elim (hn g (by rw [hc, hp]; norm_num))
    · exact False.elim (hn g (by rw [hc, hp]; norm_num))
    · rw [hc, hp]
  let ω : G →* ℝ := χ * ψ
  have hωτ : ω τ = 1 := by simp [ω, hχτ, hψτ]
  have hωnontriv : ∃ g, ω g = -1 := by simpa [ω] using hprod
  simpa [ω] using odd_coset_character_sum_zero
    ν ω τ hνsign hντ hωτ hωnontriv

/-- The precise orthogonality hypotheses needed by
`select_odd_quartic_character_bias`, for any finite family of distinct
positive-sign quadratic characters. -/
theorem finite_odd_coset_character_orthogonality
    {G I : Type*} [Group G] [Fintype G] [Fintype I]
    (ν : G →* ℝ) (τ : G)
    (χ : I → G →* ℝ)
    (hνsign : ∀ g, ν g = 1 ∨ ν g = -1)
    (hντ : ν τ = -1)
    (hχsign : ∀ i g, χ i g = 1 ∨ χ i g = -1)
    (hχτ : ∀ i, χ i τ = 1)
    (hinj : Function.Injective χ)
    (hnon : ∀ i, χ i ≠ 1) :
    (∀ i, ∑ g : {g : G // ν g = -1}, χ i g.val = 0) ∧
      (∀ j k, ∑ g : {g : G // ν g = -1},
        χ j g.val * χ k g.val =
          if j = k then (Fintype.card {g : G // ν g = -1} : ℝ) else 0) := by
  have hnegative (i : I) : ∃ g, χ i g = -1 := by
    by_contra hall
    apply hnon i
    ext g
    rcases hχsign i g with h | h
    · exact h
    · exact False.elim (hall ⟨g, h⟩)
  constructor
  · intro i
    exact odd_coset_character_sum_zero ν (χ i) τ
      hνsign hντ (hχτ i) (hnegative i)
  · intro j k
    by_cases hjk : j = k
    · subst j
      simp only [if_pos rfl]
      calc
        (∑ g : {g : G // ν g = -1}, χ k g.val * χ k g.val) =
            ∑ _g : {g : G // ν g = -1}, (1 : ℝ) := by
          apply Finset.sum_congr rfl
          intro g _
          rcases hχsign k g.val with h | h <;> simp [h]
        _ = (Fintype.card {g : G // ν g = -1} : ℝ) := by simp
    · simp only [if_neg hjk]
      exact odd_coset_character_product_sum_zero
        ν (χ j) (χ k) τ hνsign (hχsign j) (hχsign k)
        hντ (hχτ j) (hχτ k) (fun h => hjk (hinj h))

/-- Odd-coset orthogonality stated on the actual quartic Frobenius fibers.
The distinguished `τ` can be taken to be restricted complex conjugation,
which fixes all square roots of nonnegative rationals. -/
theorem oddQuartic_character_orthogonality
    (E : Finset ℕ) (i : QuarticCharacterField E)
    (hi : i ^ 2 = -1)
    {I : Type*} [Fintype I]
    (χ : I → Gal(QuarticCharacterField E/ℚ) →* ℝ)
    (τ : Gal(QuarticCharacterField E/ℚ)) (hτi : τ i = -i)
    (hχsign : ∀ j σ, χ j σ = 1 ∨ χ j σ = -1)
    (hχτ : ∀ j, χ j τ = 1)
    (hinj : Function.Injective χ)
    (hnon : ∀ j, χ j ≠ 1) :
    (∀ j, ∑ g : OddQuarticAutomorphism E i, χ j g.val = 0) ∧
      (∀ j k, ∑ g : OddQuarticAutomorphism E i,
        χ j g.val * χ k g.val =
          if j = k then
            (Fintype.card (OddQuarticAutomorphism E i) : ℝ) else 0) := by
  let ν := imaginaryGaloisCharacter E i hi
  let e := oddQuarticEquivSignFiber E i hi
  have hνsign (σ : Gal(QuarticCharacterField E/ℚ)) :
      ν σ = 1 ∨ ν σ = -1 :=
    squareRootGaloisCharacter_sign
      (QuarticCharacterField E) i (-1) (by simpa using hi)
      (by
        intro h
        rw [h] at hi
        norm_num at hi) σ
  have hντ : ν τ = -1 :=
    (squareRootGaloisCharacter_eq_neg_one_iff
      (QuarticCharacterField E) i (-1) (by simpa using hi)
      (by
        intro h
        rw [h] at hi
        norm_num at hi) τ).2 hτi
  obtain ⟨hz, ho⟩ := finite_odd_coset_character_orthogonality
    ν τ χ hνsign hντ hχsign hχτ hinj hnon
  have hcard : Fintype.card (OddQuarticAutomorphism E i) =
      Fintype.card {σ : Gal(QuarticCharacterField E/ℚ) // ν σ = -1} :=
    Fintype.card_congr e
  constructor
  · intro j
    calc
      (∑ g : OddQuarticAutomorphism E i, χ j g.val) =
          ∑ g : {σ : Gal(QuarticCharacterField E/ℚ) // ν σ = -1},
            χ j g.val :=
        Fintype.sum_equiv e _ _ (fun _ => rfl)
      _ = 0 := hz j
  · intro j k
    calc
      (∑ g : OddQuarticAutomorphism E i,
          χ j g.val * χ k g.val) =
          ∑ g : {σ : Gal(QuarticCharacterField E/ℚ) // ν σ = -1},
            χ j g.val * χ k g.val :=
        Fintype.sum_equiv e _ _ (fun _ => rfl)
      _ = if j = k then
            (Fintype.card (OddQuarticAutomorphism E i) : ℝ) else 0 := by
        rw [ho j k, hcard]

/-- The actual positive quadratic radicals in the character field satisfy
the odd-coset orthogonality equations, once duplicate squareclass
characters have been removed from the index family. -/
theorem oddQuartic_squareRootCharacter_orthogonality
    (E : Finset ℕ) (i : QuarticCharacterField E)
    (hi : i ^ 2 = -1)
    {I : Type*} [Fintype I]
    (a : I → QuarticCharacterField E) (d : I → ℚ)
    (ha : ∀ j, (a j) ^ 2 = algebraMap ℚ (QuarticCharacterField E) (d j))
    (ha0 : ∀ j, a j ≠ 0)
    (hdnonneg : ∀ j, 0 ≤ d j)
    (hnsq : ∀ (j : I) (b : ℚ), b ^ 2 ≠ d j)
    (hinj : Function.Injective
      (fun j => squareRootGaloisCharacter (QuarticCharacterField E)
        (a j) (d j) (ha j) (ha0 j))) :
    (∀ j, ∑ g : OddQuarticAutomorphism E i,
      squareRootGaloisCharacter (QuarticCharacterField E)
        (a j) (d j) (ha j) (ha0 j) g.val = 0) ∧
      (∀ j k, ∑ g : OddQuarticAutomorphism E i,
        squareRootGaloisCharacter (QuarticCharacterField E)
          (a j) (d j) (ha j) (ha0 j) g.val *
        squareRootGaloisCharacter (QuarticCharacterField E)
          (a k) (d k) (ha k) (ha0 k) g.val =
          if j = k then
            (Fintype.card (OddQuarticAutomorphism E i) : ℝ) else 0) := by
  let χ (j : I) := squareRootGaloisCharacter
    (QuarticCharacterField E) (a j) (d j) (ha j) (ha0 j)
  let τ : Gal(QuarticCharacterField E/ℚ) :=
    quarticConjugation (quarticCharacterPolynomial E)
  have hτi : τ i = -i :=
    quarticConjugation_flip_i (quarticCharacterPolynomial E) i hi
  have hχτ (j : I) : χ j τ = 1 := by
    have hfix : τ (a j) = a j :=
      quarticConjugation_fix_sqrt (quarticCharacterPolynomial E)
        (a j) (d j) (hdnonneg j) (ha j)
    change (if τ (a j) = a j then (1 : ℝ) else -1) = 1
    simp [hfix]
  exact oddQuartic_character_orthogonality E i hi χ τ hτi
    (fun j σ => squareRootGaloisCharacter_sign
      (QuarticCharacterField E) (a j) (d j) (ha j) (ha0 j) σ)
    hχτ hinj
    (fun j => squareRootGaloisCharacter_nontrivial
      (QuarticCharacterField E) (a j) (d j) (ha j)
      (ha0 j) (hnsq j))

/-- The second reciprocal budget in equation (19). A prime larger than
`T + 1` contributes at most `1 / (T + 1)` times its reciprocal. -/
theorem reciprocal_squares_le_one
    (Q : Finset ℕ) (T : ℝ) (hT : 0 ≤ T)
    (hlarge : ∀ q ∈ Q, T + 1 ≤ (q : ℝ))
    (hsum : (∑ q ∈ Q, (1 : ℝ) / q) ≤ T + 1) :
    (∑ q ∈ Q, (1 : ℝ) / (q : ℝ) ^ 2) ≤ 1 := by
  have hTp : 0 < T + 1 := by linarith
  calc
    (∑ q ∈ Q, (1 : ℝ) / (q : ℝ) ^ 2) ≤
        ∑ q ∈ Q, ((1 : ℝ) / (T + 1)) * ((1 : ℝ) / q) := by
      apply Finset.sum_le_sum
      intro q hq
      have hqp : (0 : ℝ) < q := lt_of_lt_of_le hTp (hlarge q hq)
      have hrec : (1 : ℝ) / q ≤ 1 / (T + 1) :=
        one_div_le_one_div_of_le hTp (hlarge q hq)
      calc
        (1 : ℝ) / (q : ℝ) ^ 2 = ((1 : ℝ) / q) * ((1 : ℝ) / q) := by ring
        _ ≤ ((1 : ℝ) / (T + 1)) * ((1 : ℝ) / q) := by
          exact mul_le_mul_of_nonneg_right hrec (by positivity)
    _ = ((1 : ℝ) / (T + 1)) * (∑ q ∈ Q, (1 : ℝ) / q) := by
      rw [Finset.mul_sum]
    _ ≤ ((1 : ℝ) / (T + 1)) * (T + 1) :=
      mul_le_mul_of_nonneg_left hsum (by positivity)
    _ = 1 := by field_simp

/-- Chebotarev supplies the divergent fibers needed by the simultaneous
selector. The field-theoretic characters and their target moments are passed
in explicitly; this theorem concerns the finite prime budget once those
moments are known. -/
theorem select_chebotarev_classes
    (L : Type*) [Field L] [NumberField L] [Algebra ℚ L]
    [IsGalois ℚ L] [FiniteDimensional ℚ L]
    [Fintype (ConjClasses Gal(L/ℚ))] [Nonempty (ConjClasses Gal(L/ℚ))]
    {I : Type*} [Fintype I]
    (B : ℕ) (T : ℝ) (hT : 0 ≤ T)
    (hcard : (Fintype.card (ConjClasses Gal(L/ℚ)) : ℝ) ≤ B)
    (hlarge : T + 1 ≤ (B : ℝ))
    (w : ConjClasses Gal(L/ℚ) → ℝ) (hw : ∀ C, 0 ≤ w C)
    (hwsum : ∑ C, w C = 1)
    (χ : I → ConjClasses Gal(L/ℚ) → ℝ) (c : I → ℝ)
    (hχ : ∀ i C, |χ i C| ≤ 1)
    (hmoment : ∀ i, ∑ C, w C * χ i C = -c i) :
    ∃ Q : Finset ℕ,
      (∀ q ∈ Q, q.Prime ∧ B < q ∧
        Chebotarev.UnramifiedIn ℚ L (Ideal.span {(q : 𝓞 ℚ)})) ∧
      (∑ q ∈ Q, (1 : ℝ) / q) ≤ T + 1 ∧
      (∑ q ∈ Q, (1 : ℝ) / (q : ℝ) ^ 2) ≤ 1 ∧
      (∀ i, (∑ q ∈ Q,
        χ i (Chebotarev.frobeniusClass ℚ L (Ideal.span {(q : 𝓞 ℚ)})) *
          ((1 : ℝ) / q)) ≤ -T * c i + 1) := by
  let G := ConjClasses Gal(L/ℚ)
  let P (C : G) (q : ℕ) : Prop :=
    q.Prime ∧ Chebotarev.UnramifiedIn ℚ L (Ideal.span {(q : 𝓞 ℚ)}) ∧
      Chebotarev.frobeniusClass ℚ L (Ideal.span {(q : 𝓞 ℚ)}) = C ∧ B < q
  have hcardpos : (0 : ℝ) < Fintype.card G := by
    exact_mod_cast (Fintype.card_pos : 0 < Fintype.card G)
  have hsmall : ∀ C q, P C q → (1 : ℝ) / q ≤ 1 / (Fintype.card G : ℝ) := by
    intro C q hq
    have hqlarge : (B : ℝ) < q := by exact_mod_cast hq.2.2.2
    exact one_div_le_one_div_of_le hcardpos (hcard.trans hqlarge.le)
  have hbudget : (Fintype.card G : ℝ) * (1 / (Fintype.card G : ℝ)) ≤ 1 := by
    simp [ne_of_gt hcardpos]
  obtain ⟨Q, hQ, hsum, hbias⟩ :=
    select_prime_fibers P
      (fun q => Chebotarev.frobeniusClass ℚ L (Ideal.span {(q : 𝓞 ℚ)}))
      (fun C q hq => hq.2.2.1)
      (fun C => chebotarev_primeFiber_diverge_above L C B)
      (1 / (Fintype.card G : ℝ)) (by positivity) hsmall hbudget
      w hw hwsum χ c hχ hmoment T hT
  refine ⟨Q, ?_, hsum, ?_, hbias⟩
  · intro q hq
    obtain ⟨C, hC⟩ := hQ q hq
    exact ⟨hC.1, hC.2.2.2, hC.2.1⟩
  · apply reciprocal_squares_le_one Q T hT
    · intro q hq
      obtain ⟨C, hC⟩ := hQ q hq
      have hqlarge : (B : ℝ) < q := by exact_mod_cast hC.2.2.2
      exact hlarge.trans hqlarge.le
    · exact hsum

/-- The finite Chebotarev selector with the orthogonality construction of
the character weights built in. Its result is equations (19) and the
character-sum input to (20), expressed for characters of the chosen Galois
extension. -/
theorem select_chebotarev_character_bias
    (L : Type*) [Field L] [NumberField L] [Algebra ℚ L]
    [IsGalois ℚ L] [FiniteDimensional ℚ L]
    [Fintype (ConjClasses Gal(L/ℚ))] [Nonempty (ConjClasses Gal(L/ℚ))]
    {I : Type*} [Fintype I]
    (B : ℕ) (T : ℝ) (hT : 0 ≤ T)
    (hcard : (Fintype.card (ConjClasses Gal(L/ℚ)) : ℝ) ≤ B)
    (hlarge : T + 1 ≤ (B : ℝ))
    (χ : I → ConjClasses Gal(L/ℚ) → ℝ) (c : I → ℝ)
    (hc : ∀ i, 0 ≤ c i) (hctotal : (∑ i, c i) ≤ (1 / 2 : ℝ))
    (hχ : ∀ i C, |χ i C| ≤ 1)
    (hzero : ∀ i, ∑ C, χ i C = 0)
    (horth : ∀ j i, ∑ C, χ j C * χ i C =
      if j = i then (Fintype.card (ConjClasses Gal(L/ℚ)) : ℝ) else 0) :
    ∃ Q : Finset ℕ,
      (∀ q ∈ Q, q.Prime ∧ B < q ∧
        Chebotarev.UnramifiedIn ℚ L (Ideal.span {(q : 𝓞 ℚ)})) ∧
      (∑ q ∈ Q, (1 : ℝ) / q) ≤ T + 1 ∧
      (∑ q ∈ Q, (1 : ℝ) / (q : ℝ) ^ 2) ≤ 1 ∧
      (∀ i, (∑ q ∈ Q,
        χ i (Chebotarev.frobeniusClass ℚ L (Ideal.span {(q : 𝓞 ℚ)})) *
          ((1 : ℝ) / q)) ≤ -T * c i + 1) := by
  obtain ⟨w, hw, hwsum, hmoment⟩ :=
    character_distribution_weights χ c hc hctotal hχ hzero horth
  exact select_chebotarev_classes L B T hT hcard hlarge
    w hw hwsum χ c hχ hmoment

/-- Finite selection specifically from the imaginary-inverting Frobenius
fibers of the quartic character field. The supplied finite characters are
tested simultaneously on the actual odd coset, so no inconsistent list of
square-root sign assignments is postulated. -/
theorem select_odd_quartic_character_bias
    (E : Finset ℕ) (i : QuarticCharacterField E)
    (hi : i ^ 2 = -1)
    {I : Type*} [Fintype I]
    (B : ℕ) (T : ℝ) (hT : 0 ≤ T)
    (hcard : (Fintype.card (OddQuarticAutomorphism E i) : ℝ) ≤ B)
    (hlarge : T + 1 ≤ (B : ℝ))
    (χ : I → OddQuarticAutomorphism E i → ℝ) (c : I → ℝ)
    (hc : ∀ j, 0 ≤ c j) (hctotal : (∑ j, c j) ≤ (1 / 2 : ℝ))
    (hχ : ∀ j g, |χ j g| ≤ 1)
    (hzero : ∀ j, ∑ g, χ j g = 0)
    (horth : ∀ j k, ∑ g, χ j g * χ k g =
      if j = k then (Fintype.card (OddQuarticAutomorphism E i) : ℝ)
      else 0) :
    ∃ Q : Finset ℕ,
      (∀ q ∈ Q, q.Prime ∧ B < q ∧
        Chebotarev.UnramifiedIn ℚ (QuarticCharacterField E)
          (Ideal.span {(q : 𝓞 ℚ)}) ∧
        ∃ g : OddQuarticAutomorphism E i,
          Chebotarev.frobeniusClass ℚ (QuarticCharacterField E)
            (Ideal.span {(q : 𝓞 ℚ)}) = ConjClasses.mk g.val) ∧
      (∑ q ∈ Q, (1 : ℝ) / q) ≤ T + 1 ∧
      (∑ q ∈ Q, (1 : ℝ) / (q : ℝ) ^ 2) ≤ 1 ∧
      (∀ j, (∑ q ∈ Q,
        χ j (oddQuarticClassOf E i hi q) * ((1 : ℝ) / q)) ≤
          -T * c j + 1) := by
  classical
  letI : Nonempty (OddQuarticAutomorphism E i) :=
    oddQuarticAutomorphism_nonempty E i hi
  let G := OddQuarticAutomorphism E i
  let P (g : G) (q : ℕ) : Prop :=
    q.Prime ∧ Chebotarev.UnramifiedIn ℚ (QuarticCharacterField E)
      (Ideal.span {(q : 𝓞 ℚ)}) ∧
      Chebotarev.frobeniusClass ℚ (QuarticCharacterField E)
        (Ideal.span {(q : 𝓞 ℚ)}) = ConjClasses.mk g.val ∧ B < q
  have hcardpos : (0 : ℝ) < Fintype.card G := by
    exact_mod_cast (Fintype.card_pos : 0 < Fintype.card G)
  have hsmall : ∀ g q, P g q →
      (1 : ℝ) / q ≤ 1 / (Fintype.card G : ℝ) := by
    intro g q hq
    have hqlarge : (B : ℝ) < q := by exact_mod_cast hq.2.2.2
    exact one_div_le_one_div_of_le hcardpos (hcard.trans hqlarge.le)
  have hbudget : (Fintype.card G : ℝ) *
      (1 / (Fintype.card G : ℝ)) ≤ 1 := by
    simp [ne_of_gt hcardpos]
  obtain ⟨w, hw, hwsum, hmoment⟩ :=
    character_distribution_weights χ c hc hctotal hχ hzero horth
  obtain ⟨Q, hQ, hsum, hbias⟩ :=
    select_prime_fibers P (oddQuarticClassOf E i hi)
      (fun g q hq => oddQuarticClassOf_eq E i hi q g hq.2.2.1)
      (fun g => oddQuartic_primeFiber_diverge_above E i g B)
      (1 / (Fintype.card G : ℝ)) (by positivity) hsmall hbudget
      w hw hwsum χ c hχ hmoment T hT
  refine ⟨Q, ?_, hsum, ?_, hbias⟩
  · intro q hq
    obtain ⟨g, hg⟩ := hQ q hq
    exact ⟨hg.1, hg.2.2.2, hg.2.1, g, hg.2.2.1⟩
  · apply reciprocal_squares_le_one Q T hT
    · intro q hq
      obtain ⟨g, hg⟩ := hQ q hq
      have hqlarge : (B : ℝ) < q := by exact_mod_cast hg.2.2.2
      exact hlarge.trans hqlarge.le
    · exact hsum

/-- Arithmetic Frobenius acts on an explicit integral root of unity in a
Galois extension by raising it to the norm of the prime below. -/
theorem frobenius_acts_on_root_of_unity
    (K L : Type*) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [IsGalois K L]
    (m : ℕ) [NeZero m] (𝔭 : Ideal (𝓞 K))
    [𝔭.IsPrime] (hunr : Chebotarev.UnramifiedIn K L 𝔭)
    (hcop : (Ideal.absNorm 𝔭).Coprime m)
    (𝔓 : Ideal (𝓞 L)) [𝔓.IsPrime] (hP : 𝔓.LiesOver 𝔭) :
    haveI : Finite (𝓞 L ⧸ 𝔓) :=
      Chebotarev.UnramifiedIn.finite_quotient K L hunr 𝔓 hP
    ∀ ζ : L, ζ ∈ primitiveRoots m L →
      arithFrobAt (𝓞 K) Gal(L/K) 𝔓 ζ =
        ζ ^ Ideal.absNorm 𝔭 := by
  haveI : Finite (𝓞 L ⧸ 𝔓) :=
    Chebotarev.UnramifiedIn.finite_quotient K L hunr 𝔓 hP
  intro ζ hζmem
  set φ := arithFrobAt (𝓞 K) Gal(L/K) 𝔓
  have hζ : IsPrimitiveRoot ζ m := (mem_primitiveRoots (NeZero.pos m)).mp hζmem
  set z : 𝓞 L := hζ.toInteger
  have hzc : (algebraMap (𝓞 L) L) z = ζ := rfl
  have hzpow : z ^ m = 1 := hζ.toInteger_isPrimitiveRoot.pow_eq_one
  set q := Ideal.absNorm 𝔭
  have h𝔭ne : 𝔭 ≠ ⊥ := Chebotarev.UnramifiedIn.ne_bot K L hunr
  have hcopP : (Ideal.absNorm 𝔓).Coprime m := by
    rw [Ideal.absNorm_eq_pow_inertiaDeg'_of_liesOver 𝔓 𝔭 ‹𝔭.IsPrime› h𝔭ne]
    exact Nat.Coprime.pow_left _ hcop
  have hN1 : Ideal.absNorm 𝔓 ≠ 1 :=
    fun h => ‹𝔓.IsPrime›.ne_top (Ideal.absNorm_eq_one_iff.mp h)
  have hmnotmem : (m : 𝓞 L) ∉ 𝔓 := by
    intro hmem
    have hd := Ideal.absNorm_dvd_absNorm_of_le
      ((Ideal.span_singleton_le_iff_mem _).mpr hmem)
    rw [Ideal.absNorm_span_singleton,
      show ((m : ℕ) : 𝓞 L) = algebraMap ℤ (𝓞 L) (m : ℤ) by
        push_cast; rfl,
      Algebra.norm_algebraMap, Int.natAbs_pow, Int.natAbs_natCast] at hd
    exact hN1 ((hcopP.pow_right _).eq_one_of_dvd hd)
  have hqcard : q = Nat.card (𝓞 K ⧸ 𝔓.under (𝓞 K)) := by
    change Ideal.absNorm 𝔭 = Nat.card (𝓞 K ⧸ 𝔓.under (𝓞 K))
    rw [show 𝔭 = 𝔓.under (𝓞 K) from
      Ideal.LiesOver.over (p := 𝔭) (P := 𝔓),
      Ideal.absNorm_apply, Submodule.cardQuot_apply]
  have key := (IsArithFrobAt.arithFrobAt
    (𝓞 K) Gal(L/K) 𝔓).apply_of_pow_eq_one hzpow hmnotmem
  rw [← hqcard] at key
  have hmap := congrArg (algebraMap (𝓞 L) L) key
  rwa [map_pow,
    show (algebraMap (𝓞 L) L)
      ((MulSemiringAction.toAlgHom (𝓞 K) (𝓞 L) φ) z) = φ ζ from rfl,
    hzc] at hmap

private theorem root_power_modEq {S : Type*} [CommRing S] [IsDomain S]
    {μ : S} {m : ℕ} [NeZero m] (hμ : IsPrimitiveRoot μ m)
    {a b : ℕ} (h : μ ^ a = μ ^ b) : a ≡ b [MOD m] :=
  hμ.eq_orderOf ▸ (hμ.isOfFinOrder (NeZero.ne m)).pow_eq_pow_iff_modEq.mp h

set_option backward.isDefEq.respectTransparency false in
/-- The cyclotomic character of an arithmetic Frobenius is its prime norm,
for any Galois number field containing the given root of unity. -/
theorem autToPow_frobeniusClass_out_of_root
    (K L : Type*) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [IsGalois K L]
    (m : ℕ) [NeZero m] {ζ : L} (hζ : IsPrimitiveRoot ζ m)
    (𝔭 : Ideal (𝓞 K)) [𝔭.IsPrime]
    (hunr : Chebotarev.UnramifiedIn K L 𝔭)
    (hcop : (Ideal.absNorm 𝔭).Coprime m) :
    hζ.autToPow K ((Chebotarev.frobeniusClass K L 𝔭).out : L ≃ₐ[K] L) =
      ZMod.unitOfCoprime (Ideal.absNorm 𝔭) hcop := by
  obtain ⟨𝔓, h𝔓prime, h𝔓lo, _⟩ :=
    Chebotarev.exists_prime_liesOver K L 𝔭
      (Chebotarev.UnramifiedIn.ne_bot K L hunr)
  haveI := h𝔓prime
  haveI := h𝔓lo
  haveI : Finite (𝓞 L ⧸ 𝔓) :=
    Chebotarev.UnramifiedIn.finite_quotient K L hunr 𝔓 h𝔓lo
  set φ : L ≃ₐ[K] L := arithFrobAt (𝓞 K) Gal(L/K) 𝔓
  have hclass : Chebotarev.frobeniusClass K L 𝔭 = ConjClasses.mk φ :=
    Chebotarev.frobeniusClass_eq_mk_of_isArithFrobAt K L 𝔭 hunr φ 𝔓
      (IsArithFrobAt.arithFrobAt (𝓞 K) Gal(L/K) 𝔓) h𝔓lo
  have hconj : IsConj ((Chebotarev.frobeniusClass K L 𝔭).out) φ := by
    rw [← ConjClasses.mk_eq_mk_iff_isConj, ← hclass,
      ConjClasses.mk, Quotient.out_eq]
  rw [isConj_iff_eq.mp ((hζ.autToPow K).map_isConj hconj)]
  have hact : φ ζ = ζ ^ Ideal.absNorm 𝔭 :=
    frobenius_acts_on_root_of_unity K L m 𝔭 hunr hcop 𝔓 h𝔓lo ζ
      ((mem_primitiveRoots (NeZero.pos m)).mpr hζ)
  have hspec := hζ.autToPow_spec K φ
  rw [hact] at hspec
  apply Units.ext
  rw [ZMod.coe_unitOfCoprime,
    ← ZMod.natCast_zmod_val ((hζ.autToPow K φ : (ZMod m)ˣ) : ZMod m)]
  exact (ZMod.natCast_eq_natCast_iff _ _ _).mpr
    (root_power_modEq hζ hspec)

set_option backward.isDefEq.respectTransparency false in
/-- A Frobenius class acting by inversion on a primitive fourth root forces
the underlying rational prime to be `3 mod 4`. This applies inside any
Galois number field containing that root, including multiquadratic
composita. -/
theorem mod_four_eq_three_of_frobenius
    (L : Type*) [Field L] [NumberField L] [Algebra ℚ L]
    [IsGalois ℚ L]
    {ζ : L} (hζ : IsPrimitiveRoot ζ 4)
    (σ : Gal(L/ℚ))
    (hσ : hζ.autToPow ℚ σ = ZMod.unitOfCoprime 3 (by decide))
    (q : ℕ) (hq : q.Prime) (hcop : q.Coprime 4)
    (hunr : Chebotarev.UnramifiedIn ℚ L (Ideal.span {(q : 𝓞 ℚ)}))
    (hfrob : Chebotarev.frobeniusClass ℚ L (Ideal.span {(q : 𝓞 ℚ)}) =
      ConjClasses.mk σ) :
    q % 4 = 3 := by
  let p : Ideal (𝓞 ℚ) := Ideal.span {(q : 𝓞 ℚ)}
  letI : p.IsPrime := quartic_span_nat_isPrime hq
  have hvalue :
      hζ.autToPow ℚ
          ((Chebotarev.frobeniusClass ℚ L p).out : Gal(L/ℚ)) =
        hζ.autToPow ℚ σ := by
    have hfrobp : Chebotarev.frobeniusClass ℚ L p = ConjClasses.mk σ := hfrob
    have hconj : IsConj ((Chebotarev.frobeniusClass ℚ L p).out) σ := by
      rw [← ConjClasses.mk_eq_mk_iff_isConj, ← hfrobp,
        ConjClasses.mk, Quotient.out_eq]
    exact isConj_iff_eq.mp ((hζ.autToPow ℚ).map_isConj hconj)
  have hF : hζ.autToPow ℚ
        ((Chebotarev.frobeniusClass ℚ L p).out : Gal(L/ℚ)) =
      ZMod.unitOfCoprime q hcop := by
    have hnorm : Ideal.absNorm p = q := quartic_absNorm_span_nat q
    have hcopp : (Ideal.absNorm p).Coprime 4 := by rw [hnorm]; exact hcop
    have h := autToPow_frobeniusClass_out_of_root ℚ L 4 hζ p hunr hcopp
    calc
      hζ.autToPow ℚ ((Chebotarev.frobeniusClass ℚ L p).out : Gal(L/ℚ)) =
          ZMod.unitOfCoprime (Ideal.absNorm p) hcopp := h
      _ = ZMod.unitOfCoprime q hcop := by
        apply Units.ext
        simp [ZMod.coe_unitOfCoprime, hnorm]
  have hunit : ZMod.unitOfCoprime q hcop =
      ZMod.unitOfCoprime 3 (by decide) :=
    hF.symm.trans (hvalue.trans hσ)
  have hzmod : (q : ZMod 4) = (3 : ZMod 4) := by
    simpa using congrArg Units.val hunit
  have h3val : ZMod.val (3 : ZMod 4) = 3 := by decide
  simpa [h3val, ZMod.val_natCast] using congrArg ZMod.val hzmod

/-- The `q ≡ 3 (mod 4)` bridge in the form naturally produced by
`OddQuarticAutomorphism`: the chosen automorphism flips a square root of
`-1`. -/
theorem mod_four_eq_three_of_frobenius_flip
    (L : Type*) [Field L] [NumberField L] [Algebra ℚ L]
    [IsGalois ℚ L]
    {ζ : L} (hζ : IsPrimitiveRoot ζ 4) (hζsq : ζ ^ 2 = -1)
    (σ : Gal(L/ℚ)) (hflip : σ ζ = -ζ)
    (q : ℕ) (hq : q.Prime) (hcop : q.Coprime 4)
    (hunr : Chebotarev.UnramifiedIn ℚ L (Ideal.span {(q : 𝓞 ℚ)}))
    (hfrob : Chebotarev.frobeniusClass ℚ L
      (Ideal.span {(q : 𝓞 ℚ)}) = ConjClasses.mk σ) :
    q % 4 = 3 := by
  have hcube : ζ ^ 3 = -ζ := by
    calc
      ζ ^ 3 = ζ ^ 2 * ζ := by ring
      _ = -ζ := by rw [hζsq]; ring
  have hspec := hζ.autToPow_spec ℚ σ
  rw [hflip, ← hcube] at hspec
  have hσ : hζ.autToPow ℚ σ =
      ZMod.unitOfCoprime 3 (by decide) := by
    apply Units.ext
    rw [ZMod.coe_unitOfCoprime,
      ← ZMod.natCast_zmod_val
        ((hζ.autToPow ℚ σ : (ZMod 4)ˣ) : ZMod 4)]
    exact (ZMod.natCast_eq_natCast_iff _ _ _).mpr
      (root_power_modEq hζ hspec)
  exact mod_four_eq_three_of_frobenius L hζ σ hσ q hq hcop hunr hfrob

/-- Euler's criterion inside any field of characteristic `q`. If a nonzero
square root of `d` is sent to `±` itself by the `q`-power map, that sign is
the Legendre symbol of `d` at `q`. -/
theorem legendreSym_of_power_action
    (F : Type*) [Field F] (q d : ℕ) [Fact q.Prime] (hq2 : q ≠ 2)
    [CharP F q] (a : F) (ha0 : a ≠ 0) (ha : a ^ 2 = (d : F))
    (s : ℤ) (hs : s = 1 ∨ s = -1)
    (haction : a ^ q = (s : F) * a) :
    legendreSym q d = s := by
  have hq : q.Prime := Fact.out
  letI : Algebra (ZMod q) F := ZMod.algebra F q
  letI : Fact (2 < q) := ⟨by have := hq.two_le; omega⟩
  have hdnz : (d : ZMod q) ≠ 0 := by
    intro hdz
    have hd0 : (d : F) = 0 := by
      have h := congrArg (algebraMap (ZMod q) F) hdz
      simpa using h
    exact ha0 (sq_eq_zero_iff.mp (ha.trans hd0))
  have heuler : (legendreSym q d : F) = (d : F) ^ (q / 2) := by
    have h := congrArg (algebraMap (ZMod q) F)
      (legendreSym.eq_pow q (d : ℤ))
    simpa using h
  have hodd : q % 2 = 1 := (Nat.Prime.mod_two_eq_one_iff_ne_two hq).mpr hq2
  have hqsplit : q = 2 * (q / 2) + 1 := by omega
  have hpow : a ^ q = (d : F) ^ (q / 2) * a := by
    calc
      a ^ q = a ^ (2 * (q / 2) + 1) := by rw [← hqsplit]
      _ = (d : F) ^ (q / 2) * a := by rw [pow_add, pow_mul, pow_one, ha]
  have hcast : (legendreSym q d : F) = (s : F) := by
    apply mul_right_cancel₀ ha0
    calc
      (legendreSym q d : F) * a = (d : F) ^ (q / 2) * a := by rw [heuler]
      _ = a ^ q := hpow.symm
      _ = (s : F) * a := haction
  have hdnz' : ((d : ℤ) : ZMod q) ≠ 0 := by simpa using hdnz
  rcases legendreSym.eq_one_or_neg_one (p := q) hdnz' with hleg | hleg
  · rcases hs with rfl | rfl
    · exact hleg
    · exfalso
      have hbad : (1 : F) = -1 := by simpa [hleg] using hcast
      exact (CharP.neg_one_ne_one (R := F) q) hbad.symm
  · rcases hs with rfl | rfl
    · exfalso
      have hbad : (-1 : F) = 1 := by simpa [hleg] using hcast
      exact (CharP.neg_one_ne_one (R := F) q) hbad
    · exact hleg

/-- At a prime above `q`, the arithmetic Frobenius sign on an integral
square root of `d` equals the Legendre symbol `(d/q)`. The congruence is
proved in the residue field, where Euler's criterion applies. -/
theorem legendreSym_of_arithFrob_square_root
    (L : Type*) [Field L] [NumberField L] [Algebra ℚ L] [IsGalois ℚ L]
    (q d : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (hd : ¬ q ∣ d)
    (a : 𝓞 L) (ha : a ^ 2 = (d : 𝓞 L))
    (P : Ideal (𝓞 L)) [P.IsPrime]
    (hP : P.LiesOver (Ideal.span {(q : 𝓞 ℚ)}))
    (φ : Gal(L/ℚ)) (hφ : IsArithFrobAt (𝓞 ℚ) φ P)
    (s : ℤ) (hs : s = 1 ∨ s = -1)
    (hact : φ • a = (s : 𝓞 L) * a) :
    legendreSym q d = s := by
  have hq : q.Prime := Fact.out
  let p : Ideal (𝓞 ℚ) := Ideal.span {(q : 𝓞 ℚ)}
  letI : p.IsPrime := quartic_span_nat_isPrime hq
  letI : p.IsMaximal := (inferInstance : p.IsPrime).isMaximal
    (quartic_span_nat_ne_bot hq)
  letI : P.LiesOver p := hP
  letI : P.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal P p
  let F := 𝓞 L ⧸ P
  letI : Field F := Ideal.Quotient.field P
  have hqmem : (q : 𝓞 L) ∈ P := by
    have hpq : (q : 𝓞 ℚ) ∈ p := Ideal.mem_span_singleton_self _
    simpa using (Ideal.mem_of_liesOver (P := P) (p := p) (q : 𝓞 ℚ)).mp hpq
  have hqzero : (q : F) = 0 := by
    simpa using (Ideal.Quotient.eq_zero_iff_mem.mpr hqmem)
  letI : CharP F q := (CharP.charP_iff_prime_eq_zero hq).mpr hqzero
  letI : Fact q.Prime := ⟨hq⟩
  letI : Algebra (ZMod q) F := ZMod.algebra F q
  have hdz : (d : ZMod q) ≠ 0 := by
    intro hzero
    exact hd ((ZMod.natCast_eq_zero_iff d q).mp hzero)
  have hdF : (d : F) ≠ 0 := by
    intro hzero
    apply hdz
    apply (algebraMap (ZMod q) F).injective
    simpa using hzero
  have haF : (a : F) ^ 2 = (d : F) := by
    simpa using congrArg (Ideal.Quotient.mk P) ha
  have haF0 : (a : F) ≠ 0 := by
    intro hzero
    exact hdF (by simpa [hzero] using haF.symm)
  have hunder : P.under (𝓞 ℚ) = p := hP.over.symm
  have hcard : Nat.card (𝓞 ℚ ⧸ P.under (𝓞 ℚ)) = q := by
    rw [hunder]
    simpa [Ideal.absNorm_apply, Submodule.cardQuot_apply] using
      (quartic_absNorm_span_nat q)
  have hpower : ((φ • a : 𝓞 L) : F) = (a : F) ^ q := by
    change (Ideal.Quotient.mk P)
      ((MulSemiringAction.toAlgHom (𝓞 ℚ) (𝓞 L) φ) a) =
        (Ideal.Quotient.mk P a) ^ q
    simpa only [hcard] using hφ.mk_apply a
  have hsign : ((φ • a : 𝓞 L) : F) = (s : F) * (a : F) := by
    simpa using congrArg (Ideal.Quotient.mk P) hact
  exact legendreSym_of_power_action F q d hq2 (a : F) haF0 haF s hs
    (hpower.symm.trans hsign)

/-- In an abelian Galois field, a prescribed Frobenius class acts on an
integral square root with exactly the Legendre sign at the rational prime.
The finite exceptional primes dividing `2d` are excluded explicitly. -/
theorem legendreSym_of_frobenius_square_root
    (L : Type*) [Field L] [NumberField L] [Algebra ℚ L]
    [IsGalois ℚ L] [IsMulCommutative Gal(L/ℚ)]
    (q d : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (hd : ¬ q ∣ d)
    (a : 𝓞 L) (ha : a ^ 2 = (d : 𝓞 L))
    (σ : Gal(L/ℚ)) (s : ℤ) (hs : s = 1 ∨ s = -1)
    (hact : σ • a = (s : 𝓞 L) * a)
    (hunr : Chebotarev.UnramifiedIn ℚ L (Ideal.span {(q : 𝓞 ℚ)}))
    (hfrob : Chebotarev.frobeniusClass ℚ L (Ideal.span {(q : 𝓞 ℚ)}) =
      ConjClasses.mk σ) :
    legendreSym q d = s := by
  let p : Ideal (𝓞 ℚ) := Ideal.span {(q : 𝓞 ℚ)}
  have hq : q.Prime := Fact.out
  letI : p.IsPrime := quartic_span_nat_isPrime hq
  letI : p.IsMaximal := (inferInstance : p.IsPrime).isMaximal
    (quartic_span_nat_ne_bot hq)
  obtain ⟨P, hPm, hP⟩ :=
    Ideal.exists_maximal_ideal_liesOver_of_isIntegral (S := 𝓞 L) p
  letI : P.IsPrime := hPm.isPrime
  let φ : Gal(L/ℚ) := arithFrobAt (𝓞 ℚ) Gal(L/ℚ) P
  have hφfrob : IsArithFrobAt (𝓞 ℚ) φ P :=
    IsArithFrobAt.arithFrobAt (𝓞 ℚ) Gal(L/ℚ) P
  have hclass : Chebotarev.frobeniusClass ℚ L p = ConjClasses.mk φ :=
    Chebotarev.frobeniusClass_eq_mk_of_isArithFrobAt ℚ L p hunr φ P
      hφfrob hP
  have hφσ : φ = σ := by
    letI : CommMonoid Gal(L/ℚ) := IsMulCommutative.instCommMonoid
    apply isConj_iff_eq.mp
    apply ConjClasses.mk_eq_mk_iff_isConj.mp
    exact hclass.symm.trans hfrob
  have hσfrob : IsArithFrobAt (𝓞 ℚ) σ P := by
    rw [← hφσ]
    exact hφfrob
  exact legendreSym_of_arithFrob_square_root L q d hq2 hd a ha P hP
    σ hσfrob s hs hact

/-- The real quadratic Galois character evaluates at an unramified
Frobenius class as the Legendre symbol. -/
theorem squareRootGaloisCharacter_frobenius
    (L : Type*) [Field L] [NumberField L] [Algebra ℚ L]
    [IsGalois ℚ L] [IsMulCommutative Gal(L/ℚ)]
    (q d : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (hd : ¬ q ∣ d)
    (a : 𝓞 L) (ha : a ^ 2 = (d : 𝓞 L)) (ha0 : a ≠ 0)
    (σ : Gal(L/ℚ))
    (hunr : Chebotarev.UnramifiedIn ℚ L (Ideal.span {(q : 𝓞 ℚ)}))
    (hfrob : Chebotarev.frobeniusClass ℚ L
      (Ideal.span {(q : 𝓞 ℚ)}) = ConjClasses.mk σ) :
    squareRootGaloisCharacter L (a : L) (d : ℚ)
      (by simpa using congrArg (algebraMap (𝓞 L) L) ha)
      (by exact_mod_cast ha0) σ = (legendreSym q d : ℝ) := by
  have hax : (a : L) ^ 2 = (d : L) := by
    simpa using congrArg (algebraMap (𝓞 L) L) ha
  have hax0 : (a : L) ≠ 0 := by
    exact_mod_cast ha0
  have hsq : (σ (a : L)) ^ 2 = (a : L) ^ 2 := by
    calc
      (σ (a : L)) ^ 2 = σ ((a : L) ^ 2) := (map_pow _ _ _).symm
      _ = (d : L) := by rw [hax]; simpa using σ.commutes (d : ℚ)
      _ = (a : L) ^ 2 := hax.symm
  by_cases hfix : σ (a : L) = (a : L)
  · have hact : σ • a = ((1 : ℤ) : 𝓞 L) * a := by
      apply RingOfIntegers.coe_injective
      simpa [algebraMap.smul', AlgEquiv.smul_def] using hfix
    have hleg := legendreSym_of_frobenius_square_root L q d hq2 hd
      a ha σ (1 : ℤ) (Or.inl rfl) hact hunr hfrob
    change (if σ (a : L) = (a : L) then (1 : ℝ) else -1) =
      (legendreSym q d : ℝ)
    simp [hfix, hleg]

  · have hneg : σ (a : L) = -(a : L) :=
      (eq_or_eq_neg_of_sq_eq_sq _ _ hsq).resolve_left hfix
    have hact : σ • a = (((-1 : ℤ) : 𝓞 L)) * a := by
      apply RingOfIntegers.coe_injective
      simpa [algebraMap.smul', AlgEquiv.smul_def] using hneg
    have hleg := legendreSym_of_frobenius_square_root L q d hq2 hd
      a ha σ (-1 : ℤ) (Or.inr rfl) hact hunr hfrob
    change (if σ (a : L) = (a : L) then (1 : ℝ) else -1) =
      (legendreSym q d : ℝ)
    simp [hfix, hleg]

/-- Total real-valued Legendre symbol, zero away from prime moduli. This
lets finite prime sums be stated without carrying a `Fact q.Prime` for every
natural number in the ambient finite set. -/
noncomputable def quarticLegendreValue (q d : ℕ) : ℝ :=
  if h : q.Prime then
    letI : Fact q.Prime := ⟨h⟩
    (legendreSym q d : ℝ)
  else 0

/-- Concrete finite prime supply for a family of distinct positive
quadratic characters in the quartic character field. The output is the
Legendre-symbol form of the simultaneous bias needed for equation (20). -/
theorem select_odd_quartic_root_character_bias
    (E : Finset ℕ) (i : QuarticCharacterField E)
    (hi : i ^ 2 = -1) (hprim : IsPrimitiveRoot i 4)
    {I : Type*} [Fintype I]
    (d : I → ℕ) (a : I → 𝓞 (QuarticCharacterField E))
    (ha : ∀ j, (a j) ^ 2 = (d j : 𝓞 (QuarticCharacterField E)))
    (ha0 : ∀ j, a j ≠ 0)
    (hdpos : ∀ j, 0 < d j)
    (hdsqfree : ∀ j, Squarefree (d j))
    (hdneone : ∀ j, d j ≠ 1)
    (hinj : Function.Injective
      (fun j => squareRootGaloisCharacter (QuarticCharacterField E)
        (a j : QuarticCharacterField E) (d j : ℚ)
        (by simpa using congrArg (algebraMap
          (𝓞 (QuarticCharacterField E)) (QuarticCharacterField E)) (ha j))
        (by exact_mod_cast ha0 j)))
    (B : ℕ) (T : ℝ) (hT : 0 ≤ T) (hB4 : 4 ≤ B)
    (hBd : ∀ j, d j ≤ B)
    (hcard : (Fintype.card (OddQuarticAutomorphism E i) : ℝ) ≤ B)
    (hlarge : T + 1 ≤ (B : ℝ))
    (c : I → ℝ) (hc : ∀ j, 0 ≤ c j)
    (hctotal : (∑ j, c j) ≤ (1 / 2 : ℝ)) :
    ∃ Q : Finset ℕ,
      (∀ q ∈ Q, q.Prime ∧ q % 4 = 3 ∧ B < q ∧
        Chebotarev.UnramifiedIn ℚ (QuarticCharacterField E)
          (Ideal.span {(q : 𝓞 ℚ)})) ∧
      (∑ q ∈ Q, (1 : ℝ) / q) ≤ T + 1 ∧
      (∑ q ∈ Q, (1 : ℝ) / (q : ℝ) ^ 2) ≤ 1 ∧
      (∀ j, (∑ q ∈ Q,
        quarticLegendreValue q (d j) * ((1 : ℝ) / q)) ≤
          -T * c j + 1) := by
  classical
  let L := QuarticCharacterField E
  have hax (j : I) : (a j : L) ^ 2 = (d j : L) := by
    simpa using congrArg (algebraMap (𝓞 L) L) (ha j)
  have hax0 (j : I) : (a j : L) ≠ 0 := by
    exact_mod_cast ha0 j
  let χ (j : I) (g : OddQuarticAutomorphism E i) : ℝ :=
    squareRootGaloisCharacter L (a j : L) (d j : ℚ)
      (by simpa using hax j) (hax0 j) g.val
  have hχ (j : I) (g : OddQuarticAutomorphism E i) :
      |χ j g| ≤ 1 := by
    rcases squareRootGaloisCharacter_sign L (a j : L)
        (d j : ℚ) (by simpa using hax j) (hax0 j) g.val with h | h
    · simp [χ, h]
    · simp [χ, h]
  have horth := oddQuartic_squareRootCharacter_orthogonality
    E i hi (fun j => (a j : L)) (fun j => (d j : ℚ))
    (fun j => by simpa using hax j) hax0
    (fun j => by positivity)
    (fun j => squarefree_ne_one_nonsquare_rat (d j)
      (hdsqfree j) (hdneone j)) hinj
  obtain ⟨Q, hQ, hsum, hsq, hbias⟩ :=
    select_odd_quartic_character_bias E i hi B T hT hcard hlarge
      χ c hc hctotal hχ horth.1 horth.2
  have hcop (q : ℕ) (hq : q.Prime) (hBq : B < q) :
      q.Coprime 4 := by
    apply (Nat.Prime.coprime_iff_not_dvd hq).2
    intro hdiv
    have hqle : q ≤ 4 := Nat.le_of_dvd (by decide) hdiv
    omega
  refine ⟨Q, ?_, hsum, hsq, ?_⟩
  · intro q hq
    obtain ⟨hprime, hBq, hunr, g, hfrob⟩ := hQ q hq
    exact ⟨hprime,
      mod_four_eq_three_of_frobenius_flip L hprim hi g.val
        g.property q hprime (hcop q hprime hBq) hunr hfrob,
      hBq, hunr⟩
  · intro j
    calc
      (∑ q ∈ Q, quarticLegendreValue q (d j) * ((1 : ℝ) / q)) =
          ∑ q ∈ Q, χ j (oddQuarticClassOf E i hi q) *
            ((1 : ℝ) / q) := by
        apply Finset.sum_congr rfl
        intro q hq
        obtain ⟨hprime, hBq, hunr, g, hfrob⟩ := hQ q hq
        letI : Fact q.Prime := ⟨hprime⟩
        have hqd : ¬ q ∣ d j := by
          intro hdiv
          have hqle : q ≤ d j := Nat.le_of_dvd (hdpos j) hdiv
          have hBj := hBd j
          omega
        have hq2 : q ≠ 2 := by omega
        have hleg := squareRootGaloisCharacter_frobenius L q (d j)
          hq2 hqd (a j) (ha j) (ha0 j) g.val hunr hfrob
        rw [oddQuarticClassOf_eq E i hi q g hfrob]
        change quarticLegendreValue q (d j) * ((1 : ℝ) / q) =
          squareRootGaloisCharacter L (a j : L) (d j : ℚ)
            (by simpa using hax j) (hax0 j) g.val * ((1 : ℝ) / q)
        rw [quarticLegendreValue, dif_pos hprime, hleg]
      _ ≤ -T * c j + 1 := hbias j

end Erdos940.Quartic
