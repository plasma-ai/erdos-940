import Erdos940.Quartic.GaussianDyadicFourthRoot

/-!
# The unconditional principal-congruence statement for the quartic symbol

The reciprocity calculation and dyadic fourth-root construction together
establish triviality on the principal congruence subgroup.
-/

open scoped NumberField
open NumberField IsDedekindDomain

namespace Erdos940.Quartic

/-- The quartic ideal symbol of an odd nonzero rational numerator is trivial
on Gaussian principal ideals generated by elements congruent to one modulo
the polynomial-size candidate conductor `(64R)`. -/
theorem gaussianQuarticIdealSymbol_eq_one_of_congruence
    (R : ℕ) (hR0 : R ≠ 0) (hRodd : Odd R)
    (b : 𝓞 GaussianField) (hb0 : b ≠ 0)
    (hcong : b - 1 ∈ gaussianQuarticConductorCandidate R) :
    gaussianQuarticIdealSymbol (R : 𝓞 GaussianField) (Ideal.span {b})
        (gaussianQuarticGoodIdeal_of_principal_congruences
          (R : 𝓞 GaussianField) b hb0
          (gaussianConductorCandidate_congruences R b hcong).2
          (gaussianConductorCandidate_congruences R b hcong).1) = 1 := by
  apply gaussianQuarticIdealSymbol_eq_one_of_candidate_congruence
    R hR0 hRodd b hb0 hcong
  intro v hv
  exact gaussianDyadic_exists_fourth_root v hv b
    (gaussianConductorCandidate_congruences R b hcong).1

/-- The same principal-congruence triviality for signed odd rational
numerators. Negative radicands occur among the mixed quartic constituents. -/
theorem gaussianQuarticIdealSymbol_eq_one_of_signed_odd_congruence
    (R : ℤ) (hR0 : R ≠ 0) (hRodd : Odd R)
    (b : 𝓞 GaussianField) (hb0 : b ≠ 0)
    (hcong : b - 1 ∈ gaussianQuarticSignedConductorCandidate R) :
    gaussianQuarticIdealSymbol (R : 𝓞 GaussianField) (Ideal.span {b})
        (gaussianQuarticGoodIdeal_of_principal_congruences
          (R : 𝓞 GaussianField) b hb0
          (gaussianSignedConductorCandidate_congruences R b hcong).2
          (gaussianSignedConductorCandidate_congruences R b hcong).1) = 1 := by
  apply gaussianQuarticIdealSymbol_eq_one_of_signed_congruence
    R hR0 hRodd b hb0 hcong
  intro v hv
  exact gaussianDyadic_exists_fourth_root v hv b
    (gaussianSignedConductorCandidate_congruences R b hcong).1

end Erdos940.Quartic
