import Erdos940.Quartic.QuarticTraceEleven
import Erdos940.Quartic.GaussianPrimeIdealFibers

/-!
# Conjugate Gaussian-prime quartic symbols

At the two split primes above a rational prime, a rational radicand has
quartic residue symbols that are complex conjugates. This is the local
pairing used in the eleven-constituent quartic trace.
-/

namespace Erdos940.Quartic

open NumberField IsDedekindDomain

/-- Conjugation turns the Gaussian lift of the inverse quartic character
back into the Gaussian lift of the original character. -/
theorem quarticGaussianLift_inverse_conjugate
    (q : ℕ) [Fact q.Prime] (χ : MulChar (ZMod q) ℂ)
    (hχ : orderOf χ = 4) (x : ZMod q) :
    star (quarticGaussianLift q χ⁻¹
      (by simpa [hχ] using (orderOf_inv χ)) x) =
        quarticGaussianLift q χ hχ x := by
  apply GaussianInt.toComplex_injective
  rw [GaussianInt.toComplex_star]
  simp only [quarticGaussianLift_complex]
  change star (χ⁻¹ x) = χ x
  rw [MulChar.star_apply']
  simp

/-- Reducing through the conjugate Gaussian prime matches the inverse
quartic character with the same fourth-power residue function. -/
theorem conjugateReduction_matches_inverse_character
    (q : ℕ) [Fact q.Prime]
    (ρ : GaussianInt →+* ZMod q)
    (χ : MulChar (ZMod q) ℂ) (hχ : orderOf χ = 4)
    (hρchar : ∀ x : ZMod q,
      ρ (quarticGaussianLift q χ hχ x) = x ^ ((q - 1) / 4)) :
    ∀ x : ZMod q,
      (ρ.comp (starRingEnd GaussianInt))
        (quarticGaussianLift q χ⁻¹
          (by simpa [hχ] using (orderOf_inv χ)) x) =
          x ^ ((q - 1) / 4) := by
  intro x
  simpa only [RingHom.comp_apply, starRingEnd_apply,
    quarticGaussianLift_inverse_conjugate q χ hχ x] using hρchar x

/-- Reduction modulo the conjugate Gaussian prime. -/
def conjugateGaussianReduction
    (q : ℕ) (ρ : GaussianInt →+* ZMod q) :
    GaussianInt →+* ZMod q :=
  ρ.comp (starRingEnd GaussianInt)

theorem conjugateGaussianReduction_star_prime
    (q : ℕ) (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt) (hρπ : ρ π = 0) :
    conjugateGaussianReduction q ρ (star π) = 0 := by
  simp [conjugateGaussianReduction, starRingEnd_apply, hρπ]

theorem conjugate_gaussian_prime_ne_zero
    (π : GaussianInt) (hπ0 : π ≠ 0) : star π ≠ 0 := by
  intro h
  apply hπ0
  have h' := congrArg star h
  simpa only [star_star, star_zero] using h'

theorem conjugateGaussianReduction_kernel
    (q : ℕ) (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt)
    (hker : ∀ z : GaussianInt, ρ z = 0 ↔ π ∣ z) :
    ∀ z : GaussianInt,
      conjugateGaussianReduction q ρ z = 0 ↔ star π ∣ z := by
  intro z
  change ρ (star z) = 0 ↔ star π ∣ z
  rw [hker]
  constructor
  · intro h
    have h' := map_dvd (starRingEnd GaussianInt) h
    simpa only [starRingEnd_apply, star_star] using h'
  · intro h
    have h' := map_dvd (starRingEnd GaussianInt) h
    simpa only [starRingEnd_apply, star_star] using h'

/-- The transported second prime is indeed generated by the Gaussian
conjugate of the generator of the first. -/
theorem conjugateGaussianPrimeIdeal_eq_span
    (q : ℕ) [Fact q.Prime]
    (ρ : GaussianInt →+* ZMod q) (π : GaussianInt)
    (hπ0 : π ≠ 0) (hρπ : ρ π = 0)
    (hker : ∀ z : GaussianInt, ρ z = 0 ↔ π ∣ z) :
    (gaussianPrimeIdealOfReduction q
      (conjugateGaussianReduction q ρ) (star π)
      (conjugate_gaussian_prime_ne_zero π hπ0)
      (conjugateGaussianReduction_star_prime q ρ π hρπ)).asIdeal =
        Ideal.span {gaussianFourthIntegerRingEquiv (star π)} := by
  exact gaussianPrimeIdealOfReduction_eq_span q
    (conjugateGaussianReduction q ρ) (star π)
    (conjugate_gaussian_prime_ne_zero π hπ0)
    (conjugateGaussianReduction_star_prime q ρ π hρπ)
    (conjugateGaussianReduction_kernel q ρ π hker)

private theorem prime_not_int_square
    (q : ℕ) [Fact q.Prime] (x : ℤ) : x ^ 2 ≠ q := by
  intro hx
  have hsq : x.natAbs ^ 2 = q := by
    have h := congrArg Int.natAbs hx
    simpa [Int.natAbs_pow] using h
  have hn1 : x.natAbs ≠ 1 := by
    intro hn
    have hq1 : q = 1 := by simpa [hn] using hsq.symm
    exact (Fact.out : q.Prime).ne_one hq1
  have hsf : Squarefree (x.natAbs ^ 2) := by
    rw [hsq]
    exact (Fact.out : q.Prime).squarefree
  have htwo := (Nat.squarefree_pow_iff hn1 (by decide : (2 : ℕ) ≠ 0)).mp hsf
  exact (by decide : (2 : ℕ) ≠ 1) htwo.2

/-- The two principal primes selected above a split rational prime are
different. -/
theorem conjugateGaussianPrimeIdeal_ne
    (q : ℕ) [Fact q.Prime] (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt) (hπnorm : π.norm = q)
    (hπre : (π.re : ZMod 2) = 1)
    (hπim : (π.im : ZMod 2) = 0)
    (hker : ∀ z : GaussianInt, ρ z = 0 ↔ π ∣ z) :
    gaussianPrimeIdealOfReduction q ρ π
        (gaussianPrime_ne_zero_of_norm q π hπnorm)
        ((hker π).2 (dvd_refl π)) ≠
      gaussianPrimeIdealOfReduction q
        (conjugateGaussianReduction q ρ) (star π)
        (conjugate_gaussian_prime_ne_zero π
          (gaussianPrime_ne_zero_of_norm q π hπnorm))
        (conjugateGaussianReduction_star_prime q ρ π
          ((hker π).2 (dvd_refl π))) := by
  intro hEq
  let hπ0 := gaussianPrime_ne_zero_of_norm q π hπnorm
  let hρπ := (hker π).2 (dvd_refl π)
  have hP := gaussianPrimeIdealOfReduction_eq_span q ρ π hπ0 hρπ hker
  have hPbar := conjugateGaussianPrimeIdeal_eq_span q ρ π hπ0 hρπ hker
  have hmem : gaussianFourthIntegerRingEquiv (star π) ∈
      (gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ).asIdeal := by
    rw [hEq, hPbar]
    exact Ideal.mem_span_singleton_self _
  rw [hP, Ideal.mem_span_singleton] at hmem
  have hdiv : π ∣ star π := (map_dvd_iff gaussianFourthIntegerRingEquiv).mp hmem
  obtain ⟨u, hu⟩ := hdiv
  have hnormu : u.norm = 1 := by
    have hn := congrArg Zsqrtd.norm hu
    rw [Zsqrtd.norm_mul, hπnorm, Zsqrtd.norm_conj, hπnorm] at hn
    have hq0 : (q : ℤ) ≠ 0 := by exact_mod_cast (Fact.out : q.Prime).ne_zero
    have hz : (q : ℤ) * (u.norm - 1) = 0 := by linear_combination -hn
    rcases mul_eq_zero.mp hz with hq | hu
    · exact (hq0 hq).elim
    · exact sub_eq_zero.mp hu
  have huunit : IsUnit u := Zsqrtd.norm_eq_one_iff.mp
    (by simp [hnormu])
  have hstarim : ((star π).im : ZMod 2) = 0 := by
    simp [hπim]
  rcases gaussian_associated_eq_sign_of_parity π (star π) u huunit
      hu hπre hπim hstarim with hplus | hminus
  · have him : π.im = 0 := by
      have h := congrArg Zsqrtd.im hplus
      simp only [Zsqrtd.im_star] at h
      omega
    have hsq : π.re ^ 2 = (q : ℤ) := by
      simpa [Zsqrtd.norm, him, pow_two] using hπnorm
    exact prime_not_int_square q π.re hsq
  · have hre : π.re = 0 := by
      have h := congrArg Zsqrtd.re hminus
      simp only [Zsqrtd.re_star, Zsqrtd.re_neg] at h
      omega
    have hsq : π.im ^ 2 = (q : ℤ) := by
      simpa [Zsqrtd.norm, hre, pow_two] using hπnorm
    exact prime_not_int_square q π.im hsq

/-- Every Gaussian prime ideal containing the rational prime q is one of
the two primes generated by π and its conjugate. -/
theorem gaussian_prime_over_split_eq_or_conjugate
    (q : ℕ) [Fact q.Prime] (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt) (hπnorm : π.norm = q)
    (hker : ∀ z : GaussianInt, ρ z = 0 ↔ π ∣ z)
    (Q : HeightOneSpectrum (𝓞 GaussianField))
    (hQq : (q : 𝓞 GaussianField) ∈ Q.asIdeal) :
    Q = gaussianPrimeIdealOfReduction q ρ π
        (gaussianPrime_ne_zero_of_norm q π hπnorm)
        ((hker π).2 (dvd_refl π)) ∨
      Q = gaussianPrimeIdealOfReduction q
        (conjugateGaussianReduction q ρ) (star π)
        (conjugate_gaussian_prime_ne_zero π
          (gaussianPrime_ne_zero_of_norm q π hπnorm))
        (conjugateGaussianReduction_star_prime q ρ π
          ((hker π).2 (dvd_refl π))) := by
  let hπ0 := gaussianPrime_ne_zero_of_norm q π hπnorm
  let hρπ := (hker π).2 (dvd_refl π)
  let P := gaussianPrimeIdealOfReduction q ρ π hπ0 hρπ
  let Pbar := gaussianPrimeIdealOfReduction q
    (conjugateGaussianReduction q ρ) (star π)
    (conjugate_gaussian_prime_ne_zero π hπ0)
    (conjugateGaussianReduction_star_prime q ρ π hρπ)
  have hfac : (q : 𝓞 GaussianField) =
      gaussianFourthIntegerRingEquiv π *
        gaussianFourthIntegerRingEquiv (star π) := by
    rw [← map_mul, ← Zsqrtd.norm_eq_mul_conj, hπnorm]
    simp
  rw [hfac] at hQq
  rcases Q.isPrime.mem_or_mem hQq with hπQ | hπbarQ
  · left
    have hle : P.asIdeal ≤ Q.asIdeal := by
      rw [gaussianPrimeIdealOfReduction_eq_span q ρ π hπ0 hρπ hker]
      exact (Ideal.span_singleton_le_iff_mem (I := Q.asIdeal)).2 hπQ
    exact HeightOneSpectrum.asIdeal_injective
      (P.isMaximal.eq_of_le Q.isPrime.ne_top hle).symm
  · right
    have hle : Pbar.asIdeal ≤ Q.asIdeal := by
      rw [conjugateGaussianPrimeIdeal_eq_span q ρ π hπ0 hρπ hker]
      exact (Ideal.span_singleton_le_iff_mem (I := Q.asIdeal)).2 hπbarQ
    exact HeightOneSpectrum.asIdeal_injective
      (Pbar.isMaximal.eq_of_le Q.isPrime.ne_top hle).symm

/-- In the fiber of the Gaussian prime map over q, the two conjugate
principal ideals exhaust all points. -/
theorem gaussian_split_prime_fiber_eq_or_conjugate
    (q : ℕ) [Fact q.Prime] (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt) (hπnorm : π.norm = q)
    (hker : ∀ z : GaussianInt, ρ z = 0 ↔ π ∣ z)
    (Q : HeightOneSpectrum (𝓞 GaussianField))
    (hQ : gaussianBasePrime Q = ⟨q, Fact.out⟩) :
    Q = gaussianPrimeIdealOfReduction q ρ π
        (gaussianPrime_ne_zero_of_norm q π hπnorm)
        ((hker π).2 (dvd_refl π)) ∨
      Q = gaussianPrimeIdealOfReduction q
        (conjugateGaussianReduction q ρ) (star π)
        (conjugate_gaussian_prime_ne_zero π
          (gaussianPrime_ne_zero_of_norm q π hπnorm))
        (conjugateGaussianReduction_star_prime q ρ π
          ((hker π).2 (dvd_refl π))) := by
  have hunder : Ideal.span {(q : ℤ)} = Q.asIdeal.under ℤ := by
    simpa [hQ] using gaussianBasePrime_under Q
  have hqm : (q : ℤ) ∈ Q.asIdeal.under ℤ := by
    rw [← hunder]
    exact Ideal.mem_span_singleton_self _
  have hqQ : (q : 𝓞 GaussianField) ∈ Q.asIdeal := by
    simpa only [Ideal.under, Ideal.mem_comap, map_natCast] using hqm
  exact gaussian_prime_over_split_eq_or_conjugate q ρ π hπnorm hker Q hqQ

/-- A Gaussian prime ideal whose residue field has prime cardinality q
lies over q, with inertia degree one. -/
theorem gaussianBasePrime_eq_of_absNorm_eq_prime
    (q : ℕ) [Fact q.Prime]
    (P : HeightOneSpectrum (𝓞 GaussianField))
    (hNorm : Ideal.absNorm P.asIdeal = q) :
    gaussianBasePrime P = ⟨q, Fact.out⟩ := by
  have hpow := gaussianPrime_absNorm_pow_inertiaDeg P
  rw [hNorm] at hpow
  have hf : 0 < P.asIdeal.inertiaDeg ℤ :=
    Ideal.inertiaDeg_pos P.asIdeal ℤ
  have hdiv : (gaussianBasePrime P).val ∣ q := by
    rw [← hpow]
    exact dvd_pow_self _ hf.ne'
  have hval : q = (gaussianBasePrime P).val :=
    ((Fact.out : q.Prime).dvd_iff_eq
      (gaussianBasePrime P).property.ne_one).mp hdiv
  exact Subtype.ext hval.symm

/-- The entire Gaussian-prime fiber over a split q is precisely the
pair of principal primes generated by π and its conjugate. -/
theorem gaussian_split_prime_fiber_iff
    (q : ℕ) [Fact q.Prime] (ρ : GaussianInt →+* ZMod q)
    (π : GaussianInt) (hπnorm : π.norm = q)
    (hker : ∀ z : GaussianInt, ρ z = 0 ↔ π ∣ z)
    (Q : HeightOneSpectrum (𝓞 GaussianField)) :
    gaussianBasePrime Q = ⟨q, Fact.out⟩ ↔
      Q = gaussianPrimeIdealOfReduction q ρ π
        (gaussianPrime_ne_zero_of_norm q π hπnorm)
        ((hker π).2 (dvd_refl π)) ∨
      Q = gaussianPrimeIdealOfReduction q
        (conjugateGaussianReduction q ρ) (star π)
        (conjugate_gaussian_prime_ne_zero π
          (gaussianPrime_ne_zero_of_norm q π hπnorm))
        (conjugateGaussianReduction_star_prime q ρ π
          ((hker π).2 (dvd_refl π))) := by
  constructor
  · exact gaussian_split_prime_fiber_eq_or_conjugate q ρ π hπnorm hker Q
  · rintro (rfl | rfl)
    · exact gaussianBasePrime_eq_of_absNorm_eq_prime q _
        (gaussianPrimeIdealOfReduction_absNorm q ρ π
          (gaussianPrime_ne_zero_of_norm q π hπnorm)
          ((hker π).2 (dvd_refl π)))
    · exact gaussianBasePrime_eq_of_absNorm_eq_prime q _
        (gaussianPrimeIdealOfReduction_absNorm q
          (conjugateGaussianReduction q ρ) (star π)
          (conjugate_gaussian_prime_ne_zero π
            (gaussianPrime_ne_zero_of_norm q π hπnorm))
          (conjugateGaussianReduction_star_prime q ρ π
            ((hker π).2 (dvd_refl π))))

/-- For a rational radicand, the quartic symbols at the two conjugate
Gaussian primes are inverses. The second prime is the principal prime
generated by star π, with reduction transported by Gaussian
conjugation. -/
theorem quarticRationalPrimeSymbolValue_conjugate_eq_inv
    (q : ℕ) [Fact q.Prime] (hqmod : q % 4 = 1)
    (ρ : GaussianInt →+* ZMod q) (π : GaussianInt)
    (hπ0 : π ≠ 0) (hρπ : ρ π = 0)
    (χ : MulChar (ZMod q) ℂ) (hχ : orderOf χ = 4)
    (hρchar : ∀ x : ZMod q,
      ρ (quarticGaussianLift q χ hχ x) = x ^ ((q - 1) / 4))
    (r : ZMod q) (hr : r ≠ 0) :
    quarticRationalPrimeSymbolValue q hqmod
        (conjugateGaussianReduction q ρ) (star π)
        (conjugate_gaussian_prime_ne_zero π hπ0)
        (conjugateGaussianReduction_star_prime q ρ π hρπ)
        r hr =
      (quarticRationalPrimeSymbolValue q hqmod ρ π hπ0 hρπ r hr)⁻¹ := by
  have hχinv : orderOf χ⁻¹ = 4 := by
    simpa [hχ] using (orderOf_inv χ)
  have hρbar :
      ∀ x : ZMod q,
        conjugateGaussianReduction q ρ
          (quarticGaussianLift q χ⁻¹ hχinv x) =
          x ^ ((q - 1) / 4) := by
    simpa [conjugateGaussianReduction] using
      conjugateReduction_matches_inverse_character q ρ χ hχ hρchar
  rw [quarticRationalPrimeSymbolValue_eq_character
      q hqmod (conjugateGaussianReduction q ρ) (star π)
      (conjugate_gaussian_prime_ne_zero π hπ0)
      (conjugateGaussianReduction_star_prime q ρ π hρπ)
      χ⁻¹ hχinv hρbar r hr,
    quarticRationalPrimeSymbolValue_eq_character
      q hqmod ρ π hπ0 hρπ χ hχ hρchar r hr]
  exact MulChar.inv_apply_eq_inv' χ r

/-- The inverse-value shorthand in the eleven-term trace is literally
the sum of the ideal symbols at the two conjugate Gaussian primes. -/
theorem quarticRationalPrimeSymbolTrace_eq_two_primes
    (q : ℕ) [Fact q.Prime] (hqmod : q % 4 = 1)
    (ρ : GaussianInt →+* ZMod q) (π : GaussianInt)
    (hπ0 : π ≠ 0) (hρπ : ρ π = 0)
    (χ : MulChar (ZMod q) ℂ) (hχ : orderOf χ = 4)
    (hρchar : ∀ x : ZMod q,
      ρ (quarticGaussianLift q χ hχ x) = x ^ ((q - 1) / 4))
    (r : ZMod q) (hr : r ≠ 0) :
    quarticRationalPrimeSymbolTrace q hqmod ρ π hπ0 hρπ r hr =
      quarticRationalPrimeSymbolValue q hqmod ρ π hπ0 hρπ r hr +
        quarticRationalPrimeSymbolValue q hqmod
          (conjugateGaussianReduction q ρ) (star π)
          (conjugate_gaussian_prime_ne_zero π hπ0)
          (conjugateGaussianReduction_star_prime q ρ π hρπ)
          r hr := by
  unfold quarticRationalPrimeSymbolTrace
  rw [quarticRationalPrimeSymbolValue_conjugate_eq_inv
    q hqmod ρ π hπ0 hρπ χ hχ hρchar r hr]

end Erdos940.Quartic
