import Erdos940.Quartic.GaussianHeckeCharacters
import Erdos940.Quartic.GaussianRingEquivalence
import Erdos940.Quartic.GaussianCoefficientLBound
import Erdos940.Quartic.GaussianZeroTypeLBound

/-!
# Periodic Gaussian ideal weights and the coefficient L bound

The arithmetic character supplies a weight on Gaussian integers. Once its
finite ray modulus gives a rational period `q`, this module identifies the
weight with the finite residue table used by the analytic L bound. Mean-zero
and unit bounds are kept as explicit arithmetic hypotheses.
-/

namespace Erdos940.Quartic.GaussianHeckeLBridge

open scoped NumberField
open NumberField
open Finset
open Erdos940.Quartic.GaussianCellPartition
open Erdos940.Quartic.GaussianCoefficientLBound
open Erdos940.Quartic.GaussianDiskEstimate
open Erdos940.Quartic.GaussianLBound
open Erdos940.Quartic.GaussianZeroTypeLBound

/-- The Gaussian integer represented by a lattice point, transferred to
the ring of integers of the fourth cyclotomic field. -/
noncomputable def gaussianPointInteger (p : ℤ × ℤ) : 𝓞 GaussianField :=
  gaussianFourthIntegerRingEquiv (⟨p.1, p.2⟩ : GaussianInt)

/-- A fourth root of unity in the Gaussian integer ring, viewed through a
chosen complex embedding of the Gaussian field. -/
noncomputable def gaussianQuarticComplexValue
    (ι : GaussianField →+* ℂ)
    (ζ : rootsOfUnity 4 (𝓞 GaussianField)) : ℂ :=
  ι ((((ζ : (𝓞 GaussianField)ˣ) : 𝓞 GaussianField) : GaussianField))

/-- Extend the quartic ideal symbol by zero across ideals sharing a prime
factor with `2R`, then evaluate it on the principal ideal generated by a
Gaussian lattice point. -/
noncomputable def quarticIdealLatticeWeight
    (R : 𝓞 GaussianField) (ι : GaussianField →+* ℂ)
    (p : ℤ × ℤ) : ℂ := by
  classical
  exact if h : GaussianQuarticGoodIdeal R (Ideal.span {gaussianPointInteger p}) then
    gaussianQuarticComplexValue ι
      (gaussianQuarticIdealSymbol R (Ideal.span {gaussianPointInteger p}) h)
  else 0

/-- Values of the quartic ideal symbol have complex absolute value one. -/
theorem norm_gaussianQuarticComplexValue
    (ι : GaussianField →+* ℂ)
    (ζ : rootsOfUnity 4 (𝓞 GaussianField)) :
    ‖gaussianQuarticComplexValue ι ζ‖ = 1 := by
  have hζ : (((ζ : (𝓞 GaussianField)ˣ) : 𝓞 GaussianField) ^ 4) = 1 :=
    (mem_rootsOfUnity' 4 _).mp ζ.property
  have hζ' : (((ζ : (𝓞 GaussianField)ˣ) : GaussianField) ^ 4) = 1 := by
    exact_mod_cast hζ
  have hpow : (gaussianQuarticComplexValue ι ζ) ^ 4 = 1 := by
    unfold gaussianQuarticComplexValue
    rw [← map_pow, hζ', map_one]
  exact Complex.norm_eq_one_of_pow_eq_one hpow (by decide)

/-- The extension-by-zero convention excludes the zero Gaussian integer. -/
theorem quarticIdealLatticeWeight_origin
    (R : 𝓞 GaussianField) (ι : GaussianField →+* ℂ) :
    quarticIdealLatticeWeight R ι (0, 0) = 0 := by
  have hp : gaussianPointInteger (0, 0) = 0 := by
    simp [gaussianPointInteger]
    rfl
  have hnot : ¬ GaussianQuarticGoodIdeal R
      (Ideal.span {gaussianPointInteger (0, 0)}) := by
    rw [hp, Ideal.span_singleton_zero]
    intro h
    exact h.1 rfl
  simp [quarticIdealLatticeWeight, hnot]

/-- The extension of the quartic character by zero is unit-bounded. -/
theorem norm_quarticIdealLatticeWeight_le_one
    (R : 𝓞 GaussianField) (ι : GaussianField →+* ℂ)
    (p : ℤ × ℤ) : ‖quarticIdealLatticeWeight R ι p‖ ≤ 1 := by
  classical
  unfold quarticIdealLatticeWeight
  split_ifs with h
  · exact le_of_eq (norm_gaussianQuarticComplexValue ι _)
  · simp

/-- A lattice weight periodic in each Gaussian coordinate modulo `q`. -/
def PeriodicGaussianWeight (q : ℕ) (w : ℤ × ℤ → ℂ) : Prop :=
  ∀ (i j : ℤ) (u v : Fin q),
    w (signedCellPoint q i j u v) = w (signedCellPoint q 0 0 u v)

/-- The finite residue table of a Gaussian-lattice weight. -/
def residueWeight (q : ℕ) (w : ℤ × ℤ → ℂ) : Fin q × Fin q → ℂ :=
  fun uv => w (signedCellPoint q 0 0 uv.1 uv.2)

/-- A nontrivial multiplicative eigenvalue for a permutation of the residue
table forces the mean to vanish. In applications the permutation is
multiplication by a residue unit on the Gaussian quotient. -/
theorem residue_sum_zero_of_eigenvalue
    (q : ℕ) (ω : Fin q × Fin q → ℂ)
    (e : (Fin q × Fin q) ≃ (Fin q × Fin q)) (c : ℂ)
    (hc : c ≠ 1) (he : ∀ uv, ω (e uv) = c * ω uv) :
    (∑ uv : Fin q × Fin q, ω uv) = 0 := by
  have hs : (∑ uv : Fin q × Fin q, ω uv) =
      c * ∑ uv : Fin q × Fin q, ω uv := by
    calc
      _ = ∑ uv : Fin q × Fin q, ω (e uv) := (e.sum_comp ω).symm
      _ = ∑ uv : Fin q × Fin q, c * ω uv := by
        apply Finset.sum_congr rfl
        intro uv _
        exact he uv
      _ = c * ∑ uv : Fin q × Fin q, ω uv := by rw [Finset.mul_sum]
  have hmul : (1 - c) * (∑ uv : Fin q × Fin q, ω uv) = 0 := by
    calc
      _ = (∑ uv : Fin q × Fin q, ω uv) -
          c * (∑ uv : Fin q × Fin q, ω uv) := by ring
      _ = 0 := sub_eq_zero.mpr hs
  exact (mul_eq_zero.mp hmul).resolve_left (sub_ne_zero.mpr (Ne.symm hc))

/-- A periodic weight factors exactly through the residue table. -/
theorem periodic_weight_eq_residueWeight
    (q : ℕ) (hq : 0 < q) (w : ℤ × ℤ → ℂ)
    (hperiod : PeriodicGaussianWeight q w) (p : ℤ × ℤ) :
    w p = residueWeight q w (cellOffset q hq p) := by
  conv_lhs => rw [← signedCellPoint_cellIndex_cellOffset q hq p]
  exact hperiod _ _ _ _

/-- Norm-indexed angular coefficients directly from a lattice weight. -/
noncomputable def gaussianWeightCoeff (w : ℤ × ℤ → ℂ) (n : ℕ) : ℂ :=
  ∑ p ∈ gaussianNormShell n, w p * angularTwo (integerPairComplex p)

/-- Grouping a periodic Gaussian weight by norms is identical to the
finite-table coefficient construction. -/
theorem gaussianWeightCoeff_eq_angularCoeff
    (q : ℕ) (hq : 0 < q) (w : ℤ × ℤ → ℂ)
    (hperiod : PeriodicGaussianWeight q w) (n : ℕ) :
    gaussianWeightCoeff w n =
      gaussianAngularCoeff q hq (residueWeight q w) n := by
  unfold gaussianWeightCoeff gaussianAngularCoeff
  apply Finset.sum_congr rfl
  intro p _
  rw [periodic_weight_eq_residueWeight q hq w hperiod p]

/-- The exact analytic bound for a periodic Gaussian ideal weight, once
arithmetic nonprincipality gives zero mean on residue classes. -/
theorem norm_gaussianWeightLSeries_le_log
    (q : ℕ) [NeZero q] (w : ℤ × ℤ → ℂ)
    (hperiod : PeriodicGaussianWeight q w)
    (hmean : (∑ uv : Fin q × Fin q, residueWeight q w uv) = 0)
    (hunit : ∀ uv, ‖residueWeight q w uv‖ ≤ 1)
    (σ : ℝ) (hσ₁ : 1 < σ) (hσ₂ : σ ≤ 2) :
    ‖LSeries (gaussianWeightCoeff w) (σ : ℂ)‖ ≤
      162 * Real.log ((q : ℝ) ^ 2) + 648 := by
  have hcoeff : gaussianWeightCoeff w =
      gaussianAngularCoeff q (NeZero.pos q) (residueWeight q w) := by
    funext n
    exact gaussianWeightCoeff_eq_angularCoeff q (NeZero.pos q) w hperiod n
  rw [hcoeff]
  exact norm_gaussianAngularLSeries_le_log q (residueWeight q w)
    hmean hunit σ hσ₁ hσ₂

/-- Norm-indexed infinity-type-zero coefficients from a Gaussian-lattice
weight that vanishes at zero. -/
noncomputable def gaussianZeroWeightCoeff (w : ℤ × ℤ → ℂ) (n : ℕ) : ℂ :=
  ∑ p ∈ gaussianNormShell n, w p

/-- The type-zero coefficients agree with the analytic finite-table model. -/
theorem gaussianZeroWeightCoeff_eq_zeroCoeff
    (q : ℕ) (hq : 0 < q) (w : ℤ × ℤ → ℂ)
    (hperiod : PeriodicGaussianWeight q w)
    (hzero : w (0, 0) = 0) (n : ℕ) :
    gaussianZeroWeightCoeff w n =
      gaussianZeroCoeff q hq (residueWeight q w) n := by
  unfold gaussianZeroWeightCoeff gaussianZeroCoeff zeroTypeWeight
  apply Finset.sum_congr rfl
  intro p _
  split_ifs with hp
  · subst p
    exact hzero
  · exact periodic_weight_eq_residueWeight q hq w hperiod p

/-- The infinity-type-zero L bound transfers to a periodic ideal weight. -/
theorem norm_gaussianZeroWeightLSeries_le_log
    (q : ℕ) [NeZero q] (w : ℤ × ℤ → ℂ)
    (hperiod : PeriodicGaussianWeight q w)
    (hmean : (∑ uv : Fin q × Fin q, residueWeight q w uv) = 0)
    (hunit : ∀ uv, ‖residueWeight q w uv‖ ≤ 1)
    (hzero : w (0, 0) = 0)
    (σ : ℝ) (hσ₁ : 1 < σ) (hσ₂ : σ ≤ 2) :
    ‖LSeries (gaussianZeroWeightCoeff w) (σ : ℂ)‖ ≤
      162 * Real.log ((q : ℝ) ^ 2) + 648 := by
  have hcoeff : gaussianZeroWeightCoeff w =
      gaussianZeroCoeff q (NeZero.pos q) (residueWeight q w) := by
    funext n
    exact gaussianZeroWeightCoeff_eq_zeroCoeff q (NeZero.pos q)
      w hperiod hzero n
  have hzero' : residueWeight q w
      (cellOffset q (NeZero.pos q) (0, 0)) = 0 := by
    rw [← periodic_weight_eq_residueWeight q (NeZero.pos q) w hperiod]
    exact hzero
  rw [hcoeff]
  exact norm_gaussianZeroLSeries_le_log q (residueWeight q w)
    hmean hunit hzero' σ hσ₁ hσ₂

/-- The type-two analytic estimate for the actual quartic ideal-symbol
lattice weight. Only periodicity and the zero-mean arithmetic assertion remain
as hypotheses. -/
theorem norm_quarticIdealAngularLSeries_le_log
    (q : ℕ) [NeZero q] (R : 𝓞 GaussianField)
    (ι : GaussianField →+* ℂ)
    (hperiod : PeriodicGaussianWeight q (quarticIdealLatticeWeight R ι))
    (hmean : (∑ uv : Fin q × Fin q,
      residueWeight q (quarticIdealLatticeWeight R ι) uv) = 0)
    (σ : ℝ) (hσ₁ : 1 < σ) (hσ₂ : σ ≤ 2) :
    ‖LSeries (gaussianWeightCoeff (quarticIdealLatticeWeight R ι)) (σ : ℂ)‖ ≤
      162 * Real.log ((q : ℝ) ^ 2) + 648 := by
  exact norm_gaussianWeightLSeries_le_log q _ hperiod hmean
    (fun uv => norm_quarticIdealLatticeWeight_le_one R ι _) σ hσ₁ hσ₂

/-- The type-zero analytic estimate for the same concrete quartic ideal
character, with the zero and unit bounds discharged unconditionally. -/
theorem norm_quarticIdealZeroLSeries_le_log
    (q : ℕ) [NeZero q] (R : 𝓞 GaussianField)
    (ι : GaussianField →+* ℂ)
    (hperiod : PeriodicGaussianWeight q (quarticIdealLatticeWeight R ι))
    (hmean : (∑ uv : Fin q × Fin q,
      residueWeight q (quarticIdealLatticeWeight R ι) uv) = 0)
    (σ : ℝ) (hσ₁ : 1 < σ) (hσ₂ : σ ≤ 2) :
    ‖LSeries (gaussianZeroWeightCoeff (quarticIdealLatticeWeight R ι)) (σ : ℂ)‖ ≤
      162 * Real.log ((q : ℝ) ^ 2) + 648 := by
  exact norm_gaussianZeroWeightLSeries_le_log q _ hperiod hmean
    (fun uv => norm_quarticIdealLatticeWeight_le_one R ι _)
    (quarticIdealLatticeWeight_origin R ι) σ hσ₁ hσ₂

end Erdos940.Quartic.GaussianHeckeLBridge
